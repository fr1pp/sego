# An abbreviated commit has no rev field in the header.
args: show github.com/gorilla/mux@948bec3
exit: 0
--- stdout
github.com/gorilla/mux@948bec34b516  2020-05-17  Eric Skoglund  parents 75dcda0896e1  1 file  +1 -2
    docs: Remove stale text from comment. (#568)

    Comment for CurrentRoute claimed that setting the KeepContext option would propagate
    the Route even after the request. The KeepContext option is deprecated and has no effect.

M  +1 -2  mux.go
--- request ShowCommit {"base":"948bec3^1","repo0":"github.com/gorilla/mux","rev":"948bec3"}
--- query
query ShowCommit($repo0: String!, $rev: String!, $base: String!) {
  m0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $rev) { oid subject message author { date person { displayName } } committer { date person { displayName } } parents { oid } }
  }
  d0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    comparison(base: $base, head: $rev) {
    all: fileDiffs(first: 0) { totalCount diffStat { added deleted } }
    page: fileDiffs(first: 200) { nodes { oldPath newPath stat { added deleted } } }
    }
  }
}
