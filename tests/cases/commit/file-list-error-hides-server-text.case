        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    },
    "m0": {
      "commit": {
        "author": {
          "date": "2021-02-03T04:05:06Z",
          "person": {
            "displayName": "Grace Hopper"
          }
        },
        "committer": {
