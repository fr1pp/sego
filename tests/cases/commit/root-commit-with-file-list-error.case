# A root commit whose file list errors prints without it, with a note.
args: show example.com/acme/widget@v1.0.0
exit: 0
--- stdout
example.com/acme/widget@9f2c1d3e5a7b  2020-05-04  Ada Lovelace  parents none  rev v1.0.0
    Start the project

    The first commit.
--- stderr
sego: note: root commit: Sourcegraph has no diff for it
--- request ShowCommit {"base":"v1.0.0^1","repo0":"example.com/acme/widget","rev":"v1.0.0"}
--- query
query ShowCommit($repo0: String!, $rev: String!, $base: String!) {
  m0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $rev) { oid subject message author { date person { displayName } } committer { date person { displayName } } parents { oid } }
  }
  d0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    comparison(base: $base, head: $rev) {
    all: fileDiffs(first: 0) { totalCount diffStat { added deleted } }
    page: fileDiffs(first: 200) { nodes { oldPath newPath stat { added deleted } } }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "d0": null,
    "m0": {
      "commit": {
        "author": {
          "date": "2020-05-04T10:00:00Z",
          "person": {
            "displayName": "Ada Lovelace"
          }
        },
        "committer": {
          "date": "2020-05-04T10:00:00Z",
          "person": {
            "displayName": "Ada Lovelace"
          }
        },
        "message": "Start the project\n\nThe first commit.\n",
        "oid": "9f2c1d3e5a7b4c6d8e0f1a2b3c4d5e6f70819a2b",
        "parents": [],
        "subject": "Start the project"
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    }
  },
  "errors": [
    {
      "message": "git command [git diff --secret] failed",
      "path": [
        "d0"
      ]
    }
  ]
}
