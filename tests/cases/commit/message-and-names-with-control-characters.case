    k\u{7f}l
    mid\u{d}cr
    tab	ok

M  +1 -1  $'a\033b\342\200\256c\342\200\213d\ne\015f\000g\342\200\250h\177i'
R  +2 -2  $'o-a\033b\342\200\256c\342\200\213d\ne\015f\000g\342\200\250h\177i' -> $'n-a\033b\342\200\256c\342\200\213d\ne\015f\000g\342\200\250h\177i'
A  +4 -0  $'a\033b\342\200\256c\342\200\213d\ne\015f\000g\342\200\250h\177i-added'
D  +0 -4  $'a\033b\342\200\256c\342\200\213d\ne\015f\000g\342\200\250h\177i-deleted'
--- request ShowCommit {"base":"v2.0.0^1","repo0":"example.com/acme/widget","rev":"v2.0.0"}
--- query
query ShowCommit($repo0: String!, $rev: String!, $base: String!) {
  m0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $rev) { oid subject message author { date person { displayName } } committer { date person { displayName } } parents { oid } }
  }
  d0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    comparison(base: $base, head: $rev) {
    all: fileDiffs(first: 0) { totalCount diffStat { added deleted } }
    page: fileDiffs(first: 200) { nodes { oldPath newPath stat { added deleted } } }
    }
  }
}
