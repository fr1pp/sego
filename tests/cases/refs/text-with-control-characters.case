branch  0123456789ab  2026-03-01  a\u{1b}b\u{202e}c\u{200b}d e\u{d}f\u{0}g\u{2028}h\u{7f}i  (default)
branch  a\u{1b}b\u{202e}c\u{200b}d e\u{d}f\u{0}  a\u{1b}b\u{202e}c\u{200b}d e\u{d}  b-a\u{1b}b\u{202e}c\u{200b}d e\u{d}f\u{0}g\u{2028}h\u{7f}i
tag     0123456789ab  a\u{1b}b\u{202e}c\u{200b}d e\u{d}  t-a\u{1b}b\u{202e}c\u{200b}d e\u{d}f\u{0}g\u{2028}h\u{7f}i
tag     0123456789ab  2026-02-01  a\u{1b}b\u{202e}c\u{200b}d e\u{d}f\u{0}g\u{2028}h\u{7f}i
tag     -             -           u-a\u{1b}b\u{202e}c\u{200b}d e\u{d}f\u{0}g\u{2028}h\u{7f}i
--- request Refs {"first":101,"query":"a\u001bb‮c​d\ne\rf\u0000g hi","repo0":"example.com/acme/widget"}
--- query
query Refs($repo0: String!, $first: Int!, $query: String) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    branches(first: $first, query: $query) { totalCount nodes { displayName target { oid commit { committer { date } } } } }
    tags(first: $first, query: $query) { totalCount nodes { displayName target { oid commit { committer { date } } } } }
    all_branches: branches(first: 1) { totalCount }
    all_tags: tags(first: 1) { totalCount }
  }
}
