# In JSON a tag whose commit Sourcegraph can't dereference has a null commit and date.
args: refs --json example.com/acme/widget
exit: 0
--- stdout
{"repo":"example.com/acme/widget","query":null,"default_branch":"main","branches_total":1,"tags_total":2,"branches_all":null,"tags_all":null,"branches_more":false,"tags_more":false,"refs":[{"kind":"branch","name":"main","commit":"0000000000000000000000000000000000000001","date":"2026-03-01"},{"kind":"tag","name":"v2","commit":"0000000000000000000000000000000000000002","date":"2026-02-01"},{"kind":"tag","name":"v1-tree","commit":null,"date":null}]}
--- request Refs {"first":17000,"query":null,"repo0":"example.com/acme/widget"}
--- query
query Refs($repo0: String!, $first: Int!, $query: String) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    branches(first: $first, query: $query) { totalCount nodes { displayName target { oid commit { committer { date } } } } }
    tags(first: $first, query: $query) { totalCount nodes { displayName target { oid commit { committer { date } } } } }
  }
}
--- response 200 application/json
{
  "data": {
    "r0": {
      "branches": {
        "nodes": [
          {
            "displayName": "main",
            "target": {
              "commit": {
                "committer": {
                  "date": "2026-03-01T12:00:00Z"
                }
              },
              "oid": "0000000000000000000000000000000000000001"
            }
          }
        ],
        "totalCount": 1
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget",
      "tags": {
        "nodes": [
          {
            "displayName": "v2",
            "target": {
              "commit": {
                "committer": {
                  "date": "2026-02-01T08:30:00Z"
                }
              },
              "oid": "0000000000000000000000000000000000000002"
            }
          },
          {
            "displayName": "v1-tree",
            "target": {
              "commit": null,
              "oid": "0000000000000000000000000000000000000003"
            }
          }
        ],
        "totalCount": 2
      }
    }
  }
}
