# A tag whose commit Sourcegraph can't dereference prints `-` twice.
args: refs example.com/handwritten/tagged
exit: 0
--- stdout
example.com/handwritten/tagged  1 branch  2 tags
branch  a1b2c3d4e5f6  2026-03-01  main  (default)
tag     0f1e2d3c4b5a  2026-02-01  v2
tag     -             -           v1-tree
--- request Refs {"first":101,"query":null,"repo0":"example.com/handwritten/tagged"}
--- query
query Refs($repo0: String!, $first: Int!, $query: String) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    branches(first: $first, query: $query) { totalCount nodes { displayName target { oid commit { committer { date } } } } }
    tags(first: $first, query: $query) { totalCount nodes { displayName target { oid commit { committer { date } } } } }
  }
}
--- response 200 application/json
{
  "data": {
    "r0": {
      "branches": {
        "nodes": [
          {
            "displayName": "main",
            "target": {
              "commit": {
                "committer": {
                  "date": "2026-03-01T12:00:00Z"
                }
              },
              "oid": "a1b2c3d4e5f6071829304a5b6c7d8e9f0a1b2c3d"
            }
          }
        ],
        "totalCount": 1
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/handwritten/tagged",
      "tags": {
        "nodes": [
          {
            "displayName": "v2",
            "target": {
              "commit": {
                "committer": {
                  "date": "2026-02-01T08:30:00Z"
                }
              },
              "oid": "0f1e2d3c4b5a69788796a5b4c3d2e1f0a9b8c7d6"
            }
          },
          {
            "displayName": "v1-tree",
            "target": {
              "commit": null,
              "oid": "9a8b7c6d5e4f30211203f4e5d6c7b8a990817263"
            }
          }
        ],
        "totalCount": 2
      }
    }
  }
}
