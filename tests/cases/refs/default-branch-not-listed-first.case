# The default branch is marked by name, wherever it is listed.
args: refs example.com/acme/widget
exit: 0
--- stdout
example.com/acme/widget  3 branches  0 tags
branch  000000000000  2026-01-02  b1
branch  000000000000  2026-01-02  b0  (default)
branch  000000000000  2026-01-02  b2
--- request Refs {"first":101,"query":null,"repo0":"example.com/acme/widget"}
--- query
query Refs($repo0: String!, $first: Int!, $query: String) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    branches(first: $first, query: $query) { totalCount nodes { displayName target { oid commit { committer { date } } } } }
    tags(first: $first, query: $query) { totalCount nodes { displayName target { oid commit { committer { date } } } } }
  }
}
