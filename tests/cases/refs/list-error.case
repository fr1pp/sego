# A located list error names the part, not the server's text.
args: refs example.com/handwritten/broken
exit: 1
--- stderr
sego: error: Sourcegraph failed to answer the tag list
--- request Refs {"first":101,"query":null,"repo0":"example.com/handwritten/broken"}
--- query
query Refs($repo0: String!, $first: Int!, $query: String) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    branches(first: $first, query: $query) { totalCount nodes { displayName target { oid commit { committer { date } } } } }
    tags(first: $first, query: $query) { totalCount nodes { displayName target { oid commit { committer { date } } } } }
  }
}
--- response 200 application/json
{
  "data": {
    "r0": null
  },
  "errors": [
    {
      "message": "panic occurred: runtime error: slice bounds out of range [:-1]",
      "path": [
        "r0",
        "tags",
        "nodes"
      ]
    }
  ]
}
