# JSON of a repository without refs has no default branch and no refs.
args: refs --json github.com/ascoders/blog
exit: 0
--- stdout
{"repo":"github.com/ascoders/blog","query":null,"default_branch":null,"branches_total":0,"tags_total":0,"branches_all":null,"tags_all":null,"branches_more":false,"tags_more":false,"refs":[]}
--- request Refs {"first":17000,"query":null,"repo0":"github.com/ascoders/blog"}
--- query
query Refs($repo0: String!, $first: Int!, $query: String) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    branches(first: $first, query: $query) { totalCount nodes { displayName target { oid commit { committer { date } } } } }
    tags(first: $first, query: $query) { totalCount nodes { displayName target { oid commit { committer { date } } } } }
  }
}
--- response 200 application/json recorded 2026-10-25 https://sourcegraph.com live: values
{
  "data": {
    "r0": {
      "branches": {
        "nodes": [],
        "totalCount": 0
      },
      "defaultBranch": null,
      "name": "github.com/ascoders/blog",
      "tags": {
        "nodes": [],
        "totalCount": 0
      }
    }
  }
}
