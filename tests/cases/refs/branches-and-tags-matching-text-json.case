# JSON carries the unfiltered totals beside the matching ones.
args: refs --json example.com/acme/widget release
exit: 0
--- stdout
{"repo":"example.com/acme/widget","query":"release","default_branch":"main","branches_total":2,"tags_total":3,"branches_all":16,"tags_all":40,"branches_more":false,"tags_more":false,"refs":[{"kind":"branch","name":"release-1.1","commit":"0000000000000000000000000000000000000001","date":"2026-01-02"},{"kind":"branch","name":"release-1.0","commit":"0000000000000000000000000000000000000002","date":"2026-01-02"},{"kind":"tag","name":"v1.2-release","commit":"0000000000000000000000000000000000000003","date":"2026-01-02"},{"kind":"tag","name":"v1.1-release","commit":"0000000000000000000000000000000000000004","date":"2026-01-02"},{"kind":"tag","name":"v1.0-release","commit":"0000000000000000000000000000000000000005","date":"2026-01-02"}]}
--- request Refs {"first":17000,"query":"release","repo0":"example.com/acme/widget"}
--- query
query Refs($repo0: String!, $first: Int!, $query: String) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    branches(first: $first, query: $query) { totalCount nodes { displayName target { oid commit { committer { date } } } } }
    tags(first: $first, query: $query) { totalCount nodes { displayName target { oid commit { committer { date } } } } }
    all_branches: branches(first: 1) { totalCount }
    all_tags: tags(first: 1) { totalCount }
  }
}
