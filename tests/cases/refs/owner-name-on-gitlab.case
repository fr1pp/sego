# owner/name resolves to the one host that has it.
args: refs acme/widget
exit: 0
--- stdout
gitlab.com/acme/widget  1 branch  0 tags
branch  000000000000  2026-01-02  main  (default)
--- request Refs {"first":101,"query":null,"repo0":"github.com/acme/widget","repo1":"gitlab.com/acme/widget"}
--- query
query Refs($repo0: String!, $repo1: String!, $first: Int!, $query: String) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    branches(first: $first, query: $query) { totalCount nodes { displayName target { oid commit { committer { date } } } } }
    tags(first: $first, query: $query) { totalCount nodes { displayName target { oid commit { committer { date } } } } }
  }
  r1: repository(name: $repo1) {
    name
    defaultBranch { displayName }
    branches(first: $first, query: $query) { totalCount nodes { displayName target { oid commit { committer { date } } } } }
    tags(first: $first, query: $query) { totalCount nodes { displayName target { oid commit { committer { date } } } } }
  }
}
--- response 200 application/json
{
  "data": {
    "r0": null,
    "r1": {
      "branches": {
        "nodes": [
          {
            "displayName": "main",
            "target": {
              "commit": {
                "committer": {
                  "date": "2026-01-02T03:04:05Z"
                }
              },
              "oid": "0000000000000000000000000000000000000003"
            }
          }
        ],
        "totalCount": 1
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "gitlab.com/acme/widget",
      "tags": {
        "nodes": [],
        "totalCount": 0
      }
    }
  }
}
