# A tag whose commit has no committer prints `-` for the date.
args: refs example.com/acme/widget
exit: 0
--- stdout
example.com/acme/widget  0 branches  1 tag
tag     000000000000  -           v1
--- request Refs {"first":101,"query":null,"repo0":"example.com/acme/widget"}
--- query
query Refs($repo0: String!, $first: Int!, $query: String) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    branches(first: $first, query: $query) { totalCount nodes { displayName target { oid commit { committer { date } } } } }
    tags(first: $first, query: $query) { totalCount nodes { displayName target { oid commit { committer { date } } } } }
  }
}
--- response 200 application/json
{
  "data": {
    "r0": {
      "branches": {
        "nodes": [],
        "totalCount": 0
      },
      "defaultBranch": null,
      "name": "example.com/acme/widget",
      "tags": {
        "nodes": [
          {
            "displayName": "v1",
            "target": {
              "commit": {
                "committer": null
              },
              "oid": "0000000000000000000000000000000000000007"
            }
          }
        ],
        "totalCount": 1
      }
    }
  }
}
