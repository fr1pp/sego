# owner/name that exists on both hosts is ambiguous and names both.
args: show acme/widget:README.md
exit: 1
--- stderr
sego: error: acme/widget exists as github.com/acme/widget and gitlab.com/acme/widget
--- request ShowFile {"end_0":500,"parent_0":"","path_0":"README.md","repo0":"github.com/acme/widget","repo1":"gitlab.com/acme/widget","rev0":"HEAD","start_0":1}
--- query
query ShowFile($repo0: String!, $repo1: String!, $rev0: String!, $parent_0: String!, $path_0: String!, $start_0: Int!, $end_0: Int!) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    c0: commit(rev: $rev0) {
      oid
      meta: blob(path: $path_0) { byteSize totalLines binary rawURL lfs { byteSize } }
      body: blob(path: $path_0) { content(startLine: $start_0, endLine: $end_0, textOnly: true) }
      dir: tree(path: $path_0) { entries { path } }
      parent: tree(path: $parent_0) { entries { path submodule { url commit } } }
    }
  }
  r1: repository(name: $repo1) {
    name
    defaultBranch { displayName }
    c0: commit(rev: $rev0) {
      oid
      meta: blob(path: $path_0) { byteSize totalLines binary rawURL lfs { byteSize } }
      body: blob(path: $path_0) { content(startLine: $start_0, endLine: $end_0, textOnly: true) }
      dir: tree(path: $path_0) { entries { path } }
      parent: tree(path: $parent_0) { entries { path submodule { url commit } } }
    }
  }
}
--- response 200 application/json
{
