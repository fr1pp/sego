        },
        "oid": "0123456789abcdef0123456789abcdef01234567",
        "parent": {
          "entries": [
            {
              "path": "README.md",
              "submodule": null
            }
          ]
        }
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "github.com/acme/widget"
    },
    "r1": {
      "c0": {
        "body": {
          "content": "widget\n"
        },
        "dir": null,
        "meta": {
          "binary": false,
          "byteSize": 8,
          "lfs": null,
          "rawURL": "/gitlab.com/acme/widget@89abcdef0123456789abcdef0123456789abcdef/-/raw/README.md",
          "totalLines": 1
        },
        "oid": "89abcdef0123456789abcdef0123456789abcdef",
        "parent": {
          "entries": [
