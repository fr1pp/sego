# A repository with no commits is an error.
args: show github.com/ascoders/blog:README.md
exit: 1
--- stderr
sego: error: github.com/ascoders/blog has no commits
--- request ShowFile {"end_0":500,"parent_0":"","path_0":"README.md","repo0":"github.com/ascoders/blog","rev0":"HEAD","start_0":1}
--- query
query ShowFile($repo0: String!, $rev0: String!, $parent_0: String!, $path_0: String!, $start_0: Int!, $end_0: Int!) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    c0: commit(rev: $rev0) {
      oid
      meta: blob(path: $path_0) { byteSize totalLines binary rawURL lfs { byteSize } }
      body: blob(path: $path_0) { content(startLine: $start_0, endLine: $end_0, textOnly: true) }
      dir: tree(path: $path_0) { entries { path } }
      parent: tree(path: $parent_0) { entries { path submodule { url commit } } }
    }
  }
}
--- response 200 application/json recorded 2026-10-07 https://sourcegraph.com
{
  "data": {
    "r0": {
      "c0": null,
      "defaultBranch": null,
      "name": "github.com/ascoders/blog"
    }
  }
}
