# In JSON the submodule's URL holds the characters themselves.
args: show --json example.com/acme/widget@0123456789abcdef0123456789abcdef01234567:vendor
exit: 0
--- stdout
{"repo":"example.com/acme/widget","rev":"0123456789abcdef0123456789abcdef01234567","commit":"0123456789abcdef0123456789abcdef01234567","path":"vendor","total_lines":0,"byte_size":0,"binary":false,"crlf":false,"lfs_size":null,"submodule":{"url":"https://example.com/a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi","target":null,"commit":"89abcdef0123456789abcdef0123456789abcdef"},"start":null,"end":null,"lines":[],"via_raw":false}
--- request ShowFile {"end_0":500,"parent_0":"","path_0":"vendor","repo0":"example.com/acme/widget","rev0":"0123456789abcdef0123456789abcdef01234567","start_0":1}
--- query
query ShowFile($repo0: String!, $rev0: String!, $parent_0: String!, $path_0: String!, $start_0: Int!, $end_0: Int!) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    c0: commit(rev: $rev0) {
      oid
      meta: blob(path: $path_0) { byteSize totalLines binary rawURL lfs { byteSize } }
      body: blob(path: $path_0) { content(startLine: $start_0, endLine: $end_0, textOnly: true) }
      dir: tree(path: $path_0) { entries { path } }
      parent: tree(path: $parent_0) { entries { path submodule { url commit } } }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "r0": {
      "c0": {
        "body": null,
        "dir": null,
        "meta": null,
        "oid": "0123456789abcdef0123456789abcdef01234567",
        "parent": {
          "entries": [
            {
              "path": "vendor",
              "submodule": {
                "commit": "89abcdef0123456789abcdef0123456789abcdef",
                "url": "https://example.com/a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi"
              }
            }
          ]
        }
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    }
  }
}
