# In JSON the lines hold the characters themselves, and a carriage return before a line feed marks the file as CRLF.
args: show --json example.com/acme/widget@0123456789abcdef0123456789abcdef01234567:f.txt
exit: 0
--- stdout
{"repo":"example.com/acme/widget","rev":"0123456789abcdef0123456789abcdef01234567","commit":"0123456789abcdef0123456789abcdef01234567","path":"f.txt","total_lines":9,"byte_size":50,"binary":false,"crlf":true,"lfs_size":null,"submodule":null,"start":1,"end":9,"lines":[{"line":1,"text":"a\u001bb"},{"line":2,"text":"c\u202ed"},{"line":3,"text":"e\u200bf"},{"line":4,"text":"g\u0000h"},{"line":5,"text":"i\u2028j"},{"line":6,"text":"k\u007fl"},{"line":7,"text":"mid\rcr"},{"line":8,"text":"tab\tok"},{"line":9,"text":"crlf"}],"via_raw":false}
--- request ShowFile {"end_0":500,"parent_0":"","path_0":"f.txt","repo0":"example.com/acme/widget","rev0":"0123456789abcdef0123456789abcdef01234567","start_0":1}
--- query
query ShowFile($repo0: String!, $rev0: String!, $parent_0: String!, $path_0: String!, $start_0: Int!, $end_0: Int!) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    c0: commit(rev: $rev0) {
      oid
      meta: blob(path: $path_0) { byteSize totalLines binary rawURL lfs { byteSize } }
      body: blob(path: $path_0) { content(startLine: $start_0, endLine: $end_0, textOnly: true) }
      dir: tree(path: $path_0) { entries { path } }
      parent: tree(path: $parent_0) { entries { path submodule { url commit } } }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "r0": {
      "c0": {
        "body": {
          "content": "a\u001bb\nc\u202ed\ne\u200bf\ng\u0000h\ni\u2028j\nk\u007fl\nmid\rcr\ntab\tok\ncrlf\r\n"
        },
        "dir": null,
        "meta": {
          "binary": false,
          "byteSize": 50,
          "lfs": null,
          "rawURL": "/r/example.com/acme/widget@0123456789abcdef0123456789abcdef01234567/-/raw/f.txt",
          "totalLines": 9
        },
        "oid": "0123456789abcdef0123456789abcdef01234567",
        "parent": {
          "entries": [
            {
              "path": "f.txt",
              "submodule": null
            }
          ]
        }
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    }
  }
}
