# A tree URL of the repository root names the root as a directory.
args: show https://github.com/example/handwritten/tree/main
exit: 1
--- stderr
sego: error: ./ is a directory at github.com/example/handwritten@d81fd54f1a2b (2 entries)
--- request ShowFile {"end_0":500,"parent_0":"","path_0":"","repo0":"github.com/example/handwritten","rev0":"main","start_0":1}
--- query
query ShowFile($repo0: String!, $rev0: String!, $parent_0: String!, $path_0: String!, $start_0: Int!, $end_0: Int!) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    c0: commit(rev: $rev0) {
      oid
      meta: blob(path: $path_0) { byteSize totalLines binary rawURL lfs { byteSize } }
      body: blob(path: $path_0) { content(startLine: $start_0, endLine: $end_0, textOnly: true) }
      dir: tree(path: $path_0) { entries { path } }
      parent: tree(path: $parent_0) { entries { path submodule { url commit } } }
      x0: path(path: $path_0) { __typename }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "r0": {
      "c0": {
        "body": null,
        "dir": {
          "entries": [
            {
              "path": "a"
            },
            {
              "path": "b"
            }
          ]
        },
        "meta": null,
        "oid": "d81fd54f1a2b3c4d5e6f708192a3b4c5d6e7f809",
        "parent": {
          "entries": [
            {
              "path": "docs",
              "submodule": null
            }
          ]
        },
        "x0": {
          "__typename": "GitTree"
        }
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "github.com/example/handwritten"
    }
  },
  "errors": [
    {
      "message": "not a blob",
      "path": [
        "r0",
        "c0",
        "meta"
      ]
    },
    {
      "message": "not a blob",
      "path": [
        "r0",
        "c0",
        "body"
      ]
    }
  ]
}
