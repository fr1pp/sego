--- query
query ShowFile($repo0: String!, $rev0: String!, $rev1: String!, $rev2: String!, $rev3: String!, $parent_0: String!, $path_0: String!, $start_0: Int!, $end_0: Int!, $parent_1: String!, $path_1: String!, $start_1: Int!, $end_1: Int!, $parent_2: String!, $path_2: String!, $start_2: Int!, $end_2: Int!, $parent_3: String!, $path_3: String!, $start_3: Int!, $end_3: Int!) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    c0: commit(rev: $rev0) {
      oid
      meta: blob(path: $path_0) { byteSize totalLines binary rawURL lfs { byteSize } }
      body: blob(path: $path_0) { content(startLine: $start_0, endLine: $end_0, textOnly: true) }
      dir: tree(path: $path_0) { entries { path } }
      parent: tree(path: $parent_0) { entries { path submodule { url commit } } }
      x0: path(path: $path_0) { __typename }
    }
    c1: commit(rev: $rev1) {
      oid
      meta: blob(path: $path_1) { byteSize totalLines binary rawURL lfs { byteSize } }
      body: blob(path: $path_1) { content(startLine: $start_1, endLine: $end_1, textOnly: true) }
      dir: tree(path: $path_1) { entries { path } }
      parent: tree(path: $parent_1) { entries { path submodule { url commit } } }
      x1: path(path: $path_1) { __typename }
    }
    c2: commit(rev: $rev2) {
      oid
      meta: blob(path: $path_2) { byteSize totalLines binary rawURL lfs { byteSize } }
      body: blob(path: $path_2) { content(startLine: $start_2, endLine: $end_2, textOnly: true) }
      dir: tree(path: $path_2) { entries { path } }
      parent: tree(path: $parent_2) { entries { path submodule { url commit } } }
      x2: path(path: $path_2) { __typename }
    }
    c3: commit(rev: $rev3) {
      oid
      meta: blob(path: $path_3) { byteSize totalLines binary rawURL lfs { byteSize } }
      body: blob(path: $path_3) { content(startLine: $start_3, endLine: $end_3, textOnly: true) }
      dir: tree(path: $path_3) { entries { path } }
      parent: tree(path: $parent_3) { entries { path submodule { url commit } } }
      x3: path(path: $path_3) { __typename }
    }
  }
}
