# A failed parent listing does not fail a file that was read.
args: show example.com/acme/gadget@main:a.go
exit: 0
--- stdout
example.com/acme/gadget@d81fd54f1a2b:a.go  lines 1-3 of 3  rev main
1:a
2:b
3:c
--- request ShowFile {"end_0":500,"parent_0":"","path_0":"a.go","repo0":"example.com/acme/gadget","rev0":"main","start_0":1}
--- query
query ShowFile($repo0: String!, $rev0: String!, $parent_0: String!, $path_0: String!, $start_0: Int!, $end_0: Int!) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    c0: commit(rev: $rev0) {
      oid
      meta: blob(path: $path_0) { byteSize totalLines binary rawURL lfs { byteSize } }
      body: blob(path: $path_0) { content(startLine: $start_0, endLine: $end_0, textOnly: true) }
      dir: tree(path: $path_0) { entries { path } }
      parent: tree(path: $parent_0) { entries { path submodule { url commit } } }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "r0": {
      "c0": {
        "body": {
          "content": "a\nb\nc\n"
        },
        "dir": null,
        "meta": {
          "binary": false,
          "byteSize": 6,
          "lfs": null,
          "rawURL": "/r/example.com/acme/gadget@d81fd54f1a2b3c4d5e6f708192a3b4c5d6e7f809/-/raw/a.go",
          "totalLines": 3
        },
        "oid": "d81fd54f1a2b3c4d5e6f708192a3b4c5d6e7f809",
        "parent": null
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/gadget"
    }
  },
  "errors": [
    {
      "message": "not a directory: \"a.go\"",
      "path": [
        "r0",
        "c0",
        "dir"
      ]
    },
    {
      "message": "listing failed",
      "path": [
        "r0",
        "c0",
        "parent"
      ]
    }
  ]
}
