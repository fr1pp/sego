# In JSON the file paths hold the characters themselves.
args: diff --json example.com/acme/widget@v1.0.0...v2.0.0
exit: 0
--- stdout
{"repo":"example.com/acme/widget","rev_a":"v1.0.0","rev_b":"v2.0.0","commit_a":"0123456789abcdef0123456789abcdef01234567","commit_b":"89abcdef0123456789abcdef0123456789abcdef","base":"fedcba9876543210fedcba9876543210fedcba98","files_total":4,"added":7,"deleted":7,"files":[{"status":"M","old_path":"a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi","new_path":"a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi","added":1,"deleted":1},{"status":"R","old_path":"o-a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi","new_path":"n-a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi","added":2,"deleted":2},{"status":"A","old_path":null,"new_path":"a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi-added","added":4,"deleted":0},{"status":"D","old_path":"a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi-deleted","new_path":null,"added":0,"deleted":4}],"patch":null}
--- request Diff {"a":"v1.0.0","b":"v2.0.0","paths":null,"repo0":"example.com/acme/widget"}
--- query
query Diff($repo0: String!, $a: String!, $b: String!, $paths: [String!]) {
  a0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $a) { oid }
  }
  b0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $b) { oid parents { oid } }
  }
  c0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    comparison(base: $a, head: $b) {
    all: fileDiffs(first: 0, paths: $paths) { totalCount diffStat { added deleted } }
    page: fileDiffs(paths: $paths) { nodes { oldPath newPath stat { added deleted } oldFile { ... on GitBlob { commit { oid } } } } }
    }
  }
}
