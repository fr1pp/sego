# A comparison between two commit ids has no rev field in its header.
args: diff example.com/acme/widget@0123456789ab...456789abcdef
exit: 0
--- stdout
example.com/acme/widget@0123456789ab...456789abcdef  1 file  +3 -1  base 0123456789ab
M  +3 -1  widget.go
--- request Diff {"a":"0123456789ab","b":"456789abcdef","paths":null,"repo0":"example.com/acme/widget"}
--- query
query Diff($repo0: String!, $a: String!, $b: String!, $paths: [String!]) {
  a0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $a) { oid }
  }
  b0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $b) { oid parents { oid } }
  }
  c0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    comparison(base: $a, head: $b) {
    all: fileDiffs(first: 0, paths: $paths) { totalCount diffStat { added deleted } }
    page: fileDiffs(first: 201, paths: $paths) { nodes { oldPath newPath stat { added deleted } oldFile { ... on GitBlob { commit { oid } } } } }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "a0": {
      "commit": {
        "oid": "0123456789abcdef0123456789abcdef01234567"
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    },
    "b0": {
      "commit": {
        "oid": "456789abcdef0123456789abcdef0123456789ab",
        "parents": [
          {
            "oid": "0123456789abcdef0123456789abcdef01234567"
          }
        ]
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    },
    "c0": {
      "comparison": {
        "all": {
          "diffStat": {
            "added": 3,
            "deleted": 1
          },
          "totalCount": 1
        },
        "page": {
          "nodes": [
            {
              "newPath": "widget.go",
              "oldFile": {
                "commit": {
                  "oid": "0123456789abcdef0123456789abcdef01234567"
                }
              },
              "oldPath": "widget.go",
              "stat": {
                "added": 3,
                "deleted": 1
              }
            }
          ]
        }
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    }
  }
}
