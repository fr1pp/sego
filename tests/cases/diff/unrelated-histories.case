# With no shared history the base is A itself.
args: diff example.com/handwritten/unrelated-histories@gh-pages...main
exit: 0
--- stdout
example.com/handwritten/unrelated-histories@e7df16ff0ce8...cc9969c2e219  4 files  +65 -0  base e7df16ff0ce8  rev gh-pages...main
R  +0 -0  .nojekyll -> .agents/rules/.gitkeep
A  +64 -0  .agents/rules/unit_tests.md
A  +0 -0  .agents/skills/.gitkeep
A  +1 -0  .claude/rules
--- request Diff {"a":"gh-pages","b":"main","paths":null,"repo0":"example.com/handwritten/unrelated-histories"}
--- query
query Diff($repo0: String!, $a: String!, $b: String!, $paths: [String!]) {
  a0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $a) { oid }
  }
  b0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $b) { oid parents { oid } }
  }
  c0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    comparison(base: $a, head: $b) {
    all: fileDiffs(first: 0, paths: $paths) { totalCount diffStat { added deleted } }
    page: fileDiffs(first: 201, paths: $paths) { nodes { oldPath newPath stat { added deleted } oldFile { ... on GitBlob { commit { oid } } } } }
    }
  }
}
