# A missing path with control characters, given as the argument, is escaped in the error.
args: diff example.com/acme/widget@v1.0.0...v2.0.0 $'a\eb\u{202e}c\u{200b}d\ne\rf\0g\u{2028}h\x7fi-gone'
exit: 1
--- stderr
sego: error: a\u{1b}b\u{202e}c\u{200b}d e\u{d}f\u{0}g\u{2028}h\u{7f}i-gone not found in example.com/acme/widget@0123456789ab or @89abcdef0123
--- request Diff {"a":"v1.0.0","b":"v2.0.0","path0":"a\u001bb‮c​d\ne\rf\u0000g hi-gone","paths":["a\u001bb‮c​d\ne\rf\u0000g hi-gone"],"repo0":"example.com/acme/widget"}
--- query
query Diff($repo0: String!, $a: String!, $b: String!, $paths: [String!], $path0: String!) {
  a0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $a) { oid p0: path(path: $path0) { __typename } }
  }
  b0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $b) { oid parents { oid } p0: path(path: $path0) { __typename } }
  }
  c0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    comparison(base: $a, head: $b) {
    all: fileDiffs(first: 0, paths: $paths) { totalCount diffStat { added deleted } }
    page: fileDiffs(first: 201, paths: $paths) { nodes { oldPath newPath stat { added deleted } oldFile { ... on GitBlob { commit { oid } } } } }
    patch: fileDiffs(paths: $paths) { rawDiff }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "a0": {
      "commit": {
        "oid": "0123456789abcdef0123456789abcdef01234567",
        "p0": null
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    },
    "b0": {
      "commit": {
        "oid": "89abcdef0123456789abcdef0123456789abcdef",
        "p0": null,
        "parents": [
          {
            "oid": "fedcba9876543210fedcba9876543210fedcba98"
          }
        ]
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    },
    "c0": {
      "comparison": {
        "all": {
          "diffStat": {
            "added": 0,
            "deleted": 0
          },
          "totalCount": 0
        },
        "page": {
          "nodes": []
        },
        "patch": {
          "rawDiff": ""
        }
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    }
  }
}
