# A repository that is not on the server is named.
args: diff example.com/acme/gadget@v1...v2
exit: 1
--- stderr
sego: error: example.com/acme/gadget is not on sourcegraph.com
  sourcegraph.com serves indexed repositories from github.com, gitlab.com and a few other hosts; a renamed repository appears only under its new name
--- request Diff {"a":"v1","b":"v2","paths":null,"repo0":"example.com/acme/gadget"}
--- query
query Diff($repo0: String!, $a: String!, $b: String!, $paths: [String!]) {
  a0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $a) { oid }
  }
  b0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $b) { oid parents { oid } }
  }
  c0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    comparison(base: $a, head: $b) {
    all: fileDiffs(first: 0, paths: $paths) { totalCount diffStat { added deleted } }
    page: fileDiffs(first: 201, paths: $paths) { nodes { oldPath newPath stat { added deleted } oldFile { ... on GitBlob { commit { oid } } } } }
    }
  }
}
--- response 200 application/json recorded 2026-10-25 https://sourcegraph.com live: values
{
  "data": {
    "a0": null,
    "b0": null,
    "c0": null
  }
}
