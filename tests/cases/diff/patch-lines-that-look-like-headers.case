# A patch is printed as served, indented, whatever its lines look like.
args: diff example.com/acme/widget@v1...v2 'dir/a b.go'
exit: 0
--- stdout
'example.com/acme/widget@0123456789ab...89abcdef0123:dir/a b.go'  1 file  +2 -1  base 0123456789ab  rev v1...v2
M  +2 -1  'dir/a b.go'

    diff --git dir/a b.go dir/a b.go
    index 1111111..2222222 100644
    --- dir/a b.go
    +++ dir/a b.go
    @@ -1,2 +1,2 @@
    --- foo
    +-- bar
     ctx
    +red\u{1b}[31m
    \ No newline at end of file
--- request Diff {"a":"v1","b":"v2","path0":"dir/a b.go","paths":["dir/a b.go"],"repo0":"example.com/acme/widget"}
--- query
query Diff($repo0: String!, $a: String!, $b: String!, $paths: [String!], $path0: String!) {
  a0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $a) { oid p0: path(path: $path0) { __typename } }
  }
  b0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $b) { oid parents { oid } p0: path(path: $path0) { __typename } }
  }
  c0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    comparison(base: $a, head: $b) {
    all: fileDiffs(first: 0, paths: $paths) { totalCount diffStat { added deleted } }
    page: fileDiffs(first: 201, paths: $paths) { nodes { oldPath newPath stat { added deleted } oldFile { ... on GitBlob { commit { oid } } } } }
    patch: fileDiffs(paths: $paths) { rawDiff }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "a0": {
      "commit": {
        "oid": "0123456789abcdef0123456789abcdef01234567",
        "p0": {
          "__typename": "GitBlob"
        }
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    },
    "b0": {
      "commit": {
        "oid": "89abcdef0123456789abcdef0123456789abcdef",
        "p0": {
          "__typename": "GitBlob"
        },
        "parents": [
          {
            "oid": "0123456789abcdef0123456789abcdef01234567"
          }
        ]
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    },
    "c0": {
      "comparison": {
        "all": {
          "diffStat": {
            "added": 2,
            "deleted": 1
          },
          "totalCount": 1
        },
        "page": {
          "nodes": [
            {
              "newPath": "dir/a b.go",
              "oldFile": {
                "commit": {
                  "oid": "0123456789abcdef0123456789abcdef01234567"
                }
              },
              "oldPath": "dir/a b.go",
              "stat": {
                "added": 2,
                "deleted": 1
              }
            }
          ]
        },
        "patch": {
          "rawDiff": "diff --git dir/a b.go dir/a b.go\nindex 1111111..2222222 100644\n--- dir/a b.go\n+++ dir/a b.go\n@@ -1,2 +1,2 @@\n--- foo\n+-- bar\n ctx\n+red\u001b[31m\n\\ No newline at end of file\n"
        }
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    }
  }
}
