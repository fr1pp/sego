# In JSON an empty comparison has no files and no base.
args: diff --json github.com/gorilla/mux@v1.7.0...v1.7.0
exit: 0
--- stdout
{"repo":"github.com/gorilla/mux","rev_a":"v1.7.0","rev_b":"v1.7.0","commit_a":"a7962380ca08b5a188038c69871b8d3fbdf31e89","commit_b":"a7962380ca08b5a188038c69871b8d3fbdf31e89","base":null,"files_total":0,"added":0,"deleted":0,"files":[],"patch":null}
--- request Diff {"a":"v1.7.0","b":"v1.7.0","paths":null,"repo0":"github.com/gorilla/mux"}
--- query
query Diff($repo0: String!, $a: String!, $b: String!, $paths: [String!]) {
  a0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $a) { oid }
  }
  b0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $b) { oid parents { oid } }
  }
  c0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    comparison(base: $a, head: $b) {
    all: fileDiffs(first: 0, paths: $paths) { totalCount diffStat { added deleted } }
    page: fileDiffs(paths: $paths) { nodes { oldPath newPath stat { added deleted } oldFile { ... on GitBlob { commit { oid } } } } }
    }
  }
}
