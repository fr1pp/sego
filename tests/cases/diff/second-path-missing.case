# Every plain path is checked, not only the first.
args: diff example.com/acme/widget@v1...v2 here.go gone.go
exit: 1
--- stderr
sego: error: gone.go not found in example.com/acme/widget@0123456789ab or @89abcdef0123
--- request Diff {"a":"v1","b":"v2","path0":"here.go","path1":"gone.go","paths":["here.go","gone.go"],"repo0":"example.com/acme/widget"}
--- query
query Diff($repo0: String!, $a: String!, $b: String!, $paths: [String!], $path0: String!, $path1: String!) {
  a0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $a) { oid p0: path(path: $path0) { __typename } p1: path(path: $path1) { __typename } }
  }
  b0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $b) { oid parents { oid } p0: path(path: $path0) { __typename } p1: path(path: $path1) { __typename } }
  }
  c0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    comparison(base: $a, head: $b) {
    all: fileDiffs(first: 0, paths: $paths) { totalCount diffStat { added deleted } }
    page: fileDiffs(first: 201, paths: $paths) { nodes { oldPath newPath stat { added deleted } oldFile { ... on GitBlob { commit { oid } } } } }
    patch: fileDiffs(paths: $paths) { rawDiff }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "a0": {
      "commit": {
        "oid": "0123456789abcdef0123456789abcdef01234567",
        "p0": {
          "__typename": "GitBlob"
        },
        "p1": null
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    },
    "b0": {
      "commit": {
        "oid": "89abcdef0123456789abcdef0123456789abcdef",
        "p0": {
          "__typename": "GitBlob"
        },
        "p1": null,
        "parents": [
          {
            "oid": "0123456789abcdef0123456789abcdef01234567"
          }
        ]
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    },
    "c0": {
      "comparison": {
        "all": {
          "diffStat": {
            "added": 0,
            "deleted": 0
          },
          "totalCount": 0
        },
        "page": {
          "nodes": []
        },
        "patch": {
          "rawDiff": ""
        }
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    }
  }
}
