# File paths with control characters are escaped in the rows.
args: diff example.com/acme/widget@v1.0.0...v2.0.0
exit: 0
--- stdout
example.com/acme/widget@0123456789ab...89abcdef0123  4 files  +7 -7  base fedcba987654  rev v1.0.0...v2.0.0
M  +1 -1  $'a\033b\342\200\256c\342\200\213d\ne\015f\000g\342\200\250h\177i'
R  +2 -2  $'o-a\033b\342\200\256c\342\200\213d\ne\015f\000g\342\200\250h\177i' -> $'n-a\033b\342\200\256c\342\200\213d\ne\015f\000g\342\200\250h\177i'
A  +4 -0  $'a\033b\342\200\256c\342\200\213d\ne\015f\000g\342\200\250h\177i-added'
D  +0 -4  $'a\033b\342\200\256c\342\200\213d\ne\015f\000g\342\200\250h\177i-deleted'
--- request Diff {"a":"v1.0.0","b":"v2.0.0","paths":null,"repo0":"example.com/acme/widget"}
--- query
query Diff($repo0: String!, $a: String!, $b: String!, $paths: [String!]) {
  a0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $a) { oid }
  }
  b0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $b) { oid parents { oid } }
  }
  c0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    comparison(base: $a, head: $b) {
    all: fileDiffs(first: 0, paths: $paths) { totalCount diffStat { added deleted } }
    page: fileDiffs(first: 201, paths: $paths) { nodes { oldPath newPath stat { added deleted } oldFile { ... on GitBlob { commit { oid } } } } }
    }
  }
}
