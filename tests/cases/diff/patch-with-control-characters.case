# A path with control characters, given as the argument, is escaped in the header, the row and the patch.
args: diff example.com/acme/widget@v1.0.0...v2.0.0 $'a\eb\u{202e}c\u{200b}d\ne\rf\0g\u{2028}h\x7fi'
exit: 0
--- stdout
