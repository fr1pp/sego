--- request Diff {"a":"cf84e27337f5c671f622330ed2ee1e36584d5c2e^1","b":"cf84e27337f5c671f622330ed2ee1e36584d5c2e","path0":"coloured_output_example.png","paths":["coloured_output_example.png"],"repo0":"github.com/BurntSushi/cargo-benchcmp"}
--- query
query Diff($repo0: String!, $a: String!, $b: String!, $paths: [String!], $path0: String!) {
  a0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $a) { oid p0: path(path: $path0) { __typename } }
  }
  b0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $b) { oid parents { oid } p0: path(path: $path0) { __typename } }
  }
  c0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    comparison(base: $a, head: $b) {
    all: fileDiffs(first: 0, paths: $paths) { totalCount diffStat { added deleted } }
    page: fileDiffs(first: 201, paths: $paths) { nodes { oldPath newPath stat { added deleted } oldFile { ... on GitBlob { commit { oid } } } } }
    patch: fileDiffs(paths: $paths) { rawDiff }
    }
  }
}
