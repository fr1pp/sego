# A comparison the server leaves null, without an error, is a failure.
args: diff example.com/acme/widget@v1...v2
exit: 1
--- stderr
sego: error: Sourcegraph failed to answer the comparison
--- request Diff {"a":"v1","b":"v2","paths":null,"repo0":"example.com/acme/widget"}
--- query
query Diff($repo0: String!, $a: String!, $b: String!, $paths: [String!]) {
  a0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $a) { oid }
  }
  b0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $b) { oid parents { oid } }
  }
  c0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    comparison(base: $a, head: $b) {
    all: fileDiffs(first: 0, paths: $paths) { totalCount diffStat { added deleted } }
    page: fileDiffs(first: 201, paths: $paths) { nodes { oldPath newPath stat { added deleted } oldFile { ... on GitBlob { commit { oid } } } } }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "a0": {
      "commit": {
        "oid": "0123456789abcdef0123456789abcdef01234567"
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    },
    "b0": {
      "commit": {
        "oid": "89abcdef0123456789abcdef0123456789abcdef",
        "parents": [
          {
            "oid": "0123456789abcdef0123456789abcdef01234567"
          }
        ]
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    },
    "c0": null
  }
}
