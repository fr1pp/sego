# In JSON an unchanged path has no files and an empty patch.
args: diff --json github.com/gorilla/mux@v1.7.0...v1.7.1 README.md
exit: 0
--- stdout
{"repo":"github.com/gorilla/mux","rev_a":"v1.7.0","rev_b":"v1.7.1","commit_a":"a7962380ca08b5a188038c69871b8d3fbdf31e89","commit_b":"c5c6c98bc25355028a63748a498942a6398ccd22","base":null,"files_total":0,"added":0,"deleted":0,"files":[],"patch":""}
--- request Diff {"a":"v1.7.0","b":"v1.7.1","path0":"README.md","paths":["README.md"],"repo0":"github.com/gorilla/mux"}
--- query
query Diff($repo0: String!, $a: String!, $b: String!, $paths: [String!], $path0: String!) {
  a0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $a) { oid p0: path(path: $path0) { __typename } }
  }
  b0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $b) { oid parents { oid } p0: path(path: $path0) { __typename } }
  }
  c0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    comparison(base: $a, head: $b) {
    all: fileDiffs(first: 0, paths: $paths) { totalCount diffStat { added deleted } }
    page: fileDiffs(paths: $paths) { nodes { oldPath newPath stat { added deleted } oldFile { ... on GitBlob { commit { oid } } } } }
    patch: fileDiffs(paths: $paths) { rawDiff }
    }
  }
}
