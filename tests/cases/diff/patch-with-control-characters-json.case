# In JSON the patch and the path hold the characters themselves.
args: diff --json example.com/acme/widget@v1.0.0...v2.0.0 $'a\eb\u{202e}c\u{200b}d\ne\rf\0g\u{2028}h\x7fi'
exit: 0
--- stdout
{"repo":"example.com/acme/widget","rev_a":"v1.0.0","rev_b":"v2.0.0","commit_a":"0123456789abcdef0123456789abcdef01234567","commit_b":"89abcdef0123456789abcdef0123456789abcdef","base":"fedcba9876543210fedcba9876543210fedcba98","files_total":1,"added":1,"deleted":1,"files":[{"status":"M","old_path":"a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi","new_path":"a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi","added":1,"deleted":1}],"patch":"diff --git a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi\n--- a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi\n+++ a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi\n@@ -1 +1 @@\n-a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi\n+a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi\n"}
--- request Diff {"a":"v1.0.0","b":"v2.0.0","path0":"a\u001bb‮c​d\ne\rf\u0000g hi","paths":["a\u001bb‮c​d\ne\rf\u0000g hi"],"repo0":"example.com/acme/widget"}
--- query
query Diff($repo0: String!, $a: String!, $b: String!, $paths: [String!], $path0: String!) {
  a0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $a) { oid p0: path(path: $path0) { __typename } }
  }
  b0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $b) { oid parents { oid } p0: path(path: $path0) { __typename } }
  }
  c0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    comparison(base: $a, head: $b) {
    all: fileDiffs(first: 0, paths: $paths) { totalCount diffStat { added deleted } }
    page: fileDiffs(paths: $paths) { nodes { oldPath newPath stat { added deleted } oldFile { ... on GitBlob { commit { oid } } } } }
    patch: fileDiffs(paths: $paths) { rawDiff }
    }
  }
}
