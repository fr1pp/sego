# A root commit has no parent to diff against.
args: diff example.com/acme/widget@v0.1.0
exit: 1
--- stderr
sego: error: v0.1.0 is a root commit: Sourcegraph has no diff for it
--- request Diff {"a":"v0.1.0^1","b":"v0.1.0","paths":null,"repo0":"example.com/acme/widget"}
--- query
query Diff($repo0: String!, $a: String!, $b: String!, $paths: [String!]) {
  a0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $a) { oid }
  }
  b0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $b) { oid parents { oid } }
  }
  c0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    comparison(base: $a, head: $b) {
    all: fileDiffs(first: 0, paths: $paths) { totalCount diffStat { added deleted } }
    page: fileDiffs(first: 201, paths: $paths) { nodes { oldPath newPath stat { added deleted } oldFile { ... on GitBlob { commit { oid } } } } }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "a0": {
      "commit": null,
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    },
    "b0": {
      "commit": {
        "oid": "4e8d10dc715feb79b43f1d607b45148537546a0a",
        "parents": []
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    },
    "c0": null
  },
  "errors": [
    {
      "message": "revision not found: repo 1700 @v0.1.0^1^0",
      "path": [
        "c0",
        "comparison"
      ]
    }
  ]
}
