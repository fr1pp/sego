# In JSON the names, the submodule's URL and its commit hold the characters themselves.
args: ls --json example.com/acme/widget
exit: 0
--- stdout
{"repo":"example.com/acme/widget","rev":null,"commit":"0123456789abcdef0123456789abcdef01234567","path":null,"recursive":false,"entries":[{"path":"a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi","kind":"file","submodule_url":null,"submodule_target":null,"submodule_commit":null},{"path":"a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi-dir","kind":"dir","submodule_url":null,"submodule_target":null,"submodule_commit":null},{"path":"mod","kind":"submodule","submodule_url":"https://example.com/acme/lib","submodule_target":"example.com/acme/lib@a\u001bb\u202ec\u200bd\ne\rf\u0000","submodule_commit":"a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi"},{"path":"sub","kind":"submodule","submodule_url":"https://example.com/a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi","submodule_target":null,"submodule_commit":"0123456789abcdef0123456789abcdef01234567"}]}
--- request ListTree {"parent_0":"","path_0":"","recursive_0":false,"repo0":"example.com/acme/widget","rev0":"HEAD"}
--- query
query ListTree($repo0: String!, $rev0: String!, $path_0: String!, $recursive_0: Boolean!, $parent_0: String!) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    c0: commit(rev: $rev0) {
      oid
      tree: tree(path: $path_0) { entries(recursive: $recursive_0) { path isDirectory submodule { url commit } } }
      file: blob(path: $path_0) { totalLines byteSize binary }
      parent: tree(path: $parent_0) { entries { path submodule { url commit } } }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "r0": {
      "c0": {
        "file": null,
        "oid": "0123456789abcdef0123456789abcdef01234567",
        "parent": null,
        "tree": {
          "entries": [
            {
              "isDirectory": false,
              "path": "a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi",
              "submodule": null
            },
            {
              "isDirectory": true,
              "path": "a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi-dir",
              "submodule": null
            },
            {
              "isDirectory": false,
              "path": "sub",
              "submodule": {
                "commit": "0123456789abcdef0123456789abcdef01234567",
                "url": "https://example.com/a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi"
              }
            },
            {
              "isDirectory": false,
              "path": "mod",
              "submodule": {
                "commit": "a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi",
                "url": "https://example.com/acme/lib"
              }
            }
          ]
        }
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    }
  }
}
