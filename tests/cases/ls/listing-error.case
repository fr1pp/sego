# A failed directory listing names the part, not the server's text.
args: ls example.com/acme/listing@v2.0.0:docs
exit: 1
--- stderr
sego: error: Sourcegraph failed to answer the directory listing
--- request ListTree {"parent_0":"","path_0":"docs","recursive_0":false,"repo0":"example.com/acme/listing","rev0":"v2.0.0"}
--- query
query ListTree($repo0: String!, $rev0: String!, $path_0: String!, $recursive_0: Boolean!, $parent_0: String!) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    c0: commit(rev: $rev0) {
      oid
      tree: tree(path: $path_0) { entries(recursive: $recursive_0) { path isDirectory submodule { url commit } } }
      file: blob(path: $path_0) { totalLines byteSize binary }
      parent: tree(path: $parent_0) { entries { path submodule { url commit } } }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "r0": {
      "c0": {
        "file": null,
        "oid": "0a1b2c3d4e5f60718293a4b5c6d7e8f901234567",
        "parent": {
          "entries": [
            {
              "path": "docs",
              "submodule": null
            }
          ]
        },
        "tree": null
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/listing"
    }
  },
  "errors": [
    {
      "message": "rpc error: code = Internal desc = git command failed on host gitserver-3.internal",
      "path": [
        "r0",
        "c0",
        "tree"
      ]
    }
  ]
}
