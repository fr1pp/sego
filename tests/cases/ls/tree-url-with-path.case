# A tree URL names a branch or tag and a path; the split is settled by asking.
args: ls https://github.com/gorilla/mux/tree/v1.8.0/.github
exit: 0
--- stdout
github.com/gorilla/mux@98cb6bf42e08:.github  2 entries  2 files  rev v1.8.0
file       .github/release-drafter.yml
file       .github/stale.yml
--- request ListTree {"parent_0":"","parent_1":"","path_0":".github","path_1":"","recursive_0":false,"recursive_1":false,"repo0":"github.com/gorilla/mux","rev0":"v1.8.0","rev1":"v1.8.0/.github"}
--- query
query ListTree($repo0: String!, $rev0: String!, $rev1: String!, $path_0: String!, $recursive_0: Boolean!, $parent_0: String!, $path_1: String!, $recursive_1: Boolean!, $parent_1: String!) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    c0: commit(rev: $rev0) {
      oid
      tree: tree(path: $path_0) { entries(recursive: $recursive_0) { path isDirectory submodule { url commit } } }
      file: blob(path: $path_0) { totalLines byteSize binary }
      parent: tree(path: $parent_0) { entries { path submodule { url commit } } }
      x0: path(path: $path_0) { __typename }
    }
    c1: commit(rev: $rev1) {
      oid
      tree: tree(path: $path_1) { entries(recursive: $recursive_1) { path isDirectory submodule { url commit } } }
      file: blob(path: $path_1) { totalLines byteSize binary }
      parent: tree(path: $parent_1) { entries { path submodule { url commit } } }
      x1: path(path: $path_1) { __typename }
    }
  }
}
