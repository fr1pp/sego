# A path with a space is shell-quoted in the header and the rows, so each pastes into the next command.
args: ls 'example.com/acme/widget@v1.0.0:a b'
exit: 0
--- stdout
'example.com/acme/widget@98cb6bf42e08:a b'  2 entries  1 dir  1 file  rev v1.0.0
file       'a b/c.go'
dir        'a b/d e'/
--- request ListTree {"parent_0":"","path_0":"a b","recursive_0":false,"repo0":"example.com/acme/widget","rev0":"v1.0.0"}
--- query
query ListTree($repo0: String!, $rev0: String!, $path_0: String!, $recursive_0: Boolean!, $parent_0: String!) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    c0: commit(rev: $rev0) {
      oid
      tree: tree(path: $path_0) { entries(recursive: $recursive_0) { path isDirectory submodule { url commit } } }
      file: blob(path: $path_0) { totalLines byteSize binary }
      parent: tree(path: $parent_0) { entries { path submodule { url commit } } }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "r0": {
      "c0": {
        "file": null,
        "oid": "98cb6bf42e086f6af920b965c38cacc07402d51b",
        "parent": {
          "entries": [
            {
              "isDirectory": true,
              "path": "a b",
              "submodule": null
            }
          ]
        },
        "tree": {
          "entries": [
            {
              "isDirectory": false,
              "path": "a b/c.go",
              "submodule": null
            },
            {
              "isDirectory": true,
              "path": "a b/d e",
              "submodule": null
            }
          ]
        }
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    }
  }
}
