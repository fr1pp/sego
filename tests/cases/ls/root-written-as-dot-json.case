# A root written as `:.` asks for the empty path and is null in JSON.
args: ls --json example.com/acme/widget@v1.0.0:.
exit: 0
--- stdout
{"repo":"example.com/acme/widget","rev":"v1.0.0","commit":"98cb6bf42e086f6af920b965c38cacc07402d51b","path":null,"recursive":false,"entries":[{"path":"docs","kind":"dir","submodule_url":null,"submodule_target":null,"submodule_commit":null},{"path":"mux.go","kind":"file","submodule_url":null,"submodule_target":null,"submodule_commit":null}]}
--- request ListTree {"parent_0":"","path_0":"","recursive_0":false,"repo0":"example.com/acme/widget","rev0":"v1.0.0"}
--- query
query ListTree($repo0: String!, $rev0: String!, $path_0: String!, $recursive_0: Boolean!, $parent_0: String!) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    c0: commit(rev: $rev0) {
      oid
      tree: tree(path: $path_0) { entries(recursive: $recursive_0) { path isDirectory submodule { url commit } } }
      file: blob(path: $path_0) { totalLines byteSize binary }
      parent: tree(path: $parent_0) { entries { path submodule { url commit } } }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "r0": {
      "c0": {
        "file": null,
        "oid": "98cb6bf42e086f6af920b965c38cacc07402d51b",
        "parent": null,
        "tree": {
          "entries": [
            {
              "isDirectory": true,
              "path": "docs",
              "submodule": null
            },
            {
              "isDirectory": false,
              "path": "mux.go",
              "submodule": null
            }
          ]
        }
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    }
  }
}
