# A path with control characters, given as the argument, is escaped in the header and the rows.
args: ls $'example.com/acme/widget:a\eb\u{202e}c\u{200b}d\ne\rf\0g\u{2028}h\x7fi'
exit: 0
--- stdout
$'example.com/acme/widget@0123456789ab:a\033b\342\200\256c\342\200\213d\ne\015f\000g\342\200\250h\177i'  3 entries  1 dir  1 file  1 submodule
file       $'a\033b\342\200\256c\342\200\213d\ne\015f\000g\342\200\250h\177i/a\033b\342\200\256c\342\200\213d\ne\015f\000g\342\200\250h\177i'
dir        $'a\033b\342\200\256c\342\200\213d\ne\015f\000g\342\200\250h\177i/a\033b\342\200\256c\342\200\213d\ne\015f\000g\342\200\250h\177i-dir'/
submodule  $'a\033b\342\200\256c\342\200\213d\ne\015f\000g\342\200\250h\177i/sub'  https://example.com/a\u{1b}b\u{202e}c\u{200b}d e\u{d}f\u{0}g\u{2028}h\u{7f}i
--- request ListTree {"parent_0":"","path_0":"a\u001bb‮c​d\ne\rf\u0000g hi","recursive_0":false,"repo0":"example.com/acme/widget","rev0":"HEAD"}
--- query
query ListTree($repo0: String!, $rev0: String!, $path_0: String!, $recursive_0: Boolean!, $parent_0: String!) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    c0: commit(rev: $rev0) {
      oid
      tree: tree(path: $path_0) { entries(recursive: $recursive_0) { path isDirectory submodule { url commit } } }
      file: blob(path: $path_0) { totalLines byteSize binary }
      parent: tree(path: $parent_0) { entries { path submodule { url commit } } }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "r0": {
      "c0": {
        "file": null,
        "oid": "0123456789abcdef0123456789abcdef01234567",
        "parent": {
          "entries": [
            {
              "path": "a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi",
              "submodule": null
            }
          ]
        },
        "tree": {
          "entries": [
            {
              "isDirectory": false,
              "path": "a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi/a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi",
              "submodule": null
            },
            {
              "isDirectory": true,
              "path": "a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi/a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi-dir",
              "submodule": null
            },
            {
              "isDirectory": false,
              "path": "a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi/sub",
              "submodule": {
                "commit": "0123456789abcdef0123456789abcdef01234567",
                "url": "https://example.com/a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi"
              }
            }
          ]
        }
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    }
  }
}
