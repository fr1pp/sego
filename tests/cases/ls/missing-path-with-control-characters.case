# A missing path with control characters is escaped in the error.
args: ls $'example.com/acme/widget:a\eb\u{202e}c\u{200b}d\ne\rf\0g\u{2028}h\x7fi-gone'
exit: 1
--- stderr
sego: error: a\u{1b}b\u{202e}c\u{200b}d e\u{d}f\u{0}g\u{2028}h\u{7f}i-gone not found in example.com/acme/widget@0123456789ab
--- request ListTree {"parent_0":"","path_0":"a\u001bb‮c​d\ne\rf\u0000g hi-gone","recursive_0":false,"repo0":"example.com/acme/widget","rev0":"HEAD"}
--- query
query ListTree($repo0: String!, $rev0: String!, $path_0: String!, $recursive_0: Boolean!, $parent_0: String!) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    c0: commit(rev: $rev0) {
      oid
      tree: tree(path: $path_0) { entries(recursive: $recursive_0) { path isDirectory submodule { url commit } } }
      file: blob(path: $path_0) { totalLines byteSize binary }
      parent: tree(path: $parent_0) { entries { path submodule { url commit } } }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "r0": {
      "c0": {
        "file": null,
        "oid": "0123456789abcdef0123456789abcdef01234567",
        "parent": {
          "entries": []
        },
        "tree": null
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    }
  }
}
