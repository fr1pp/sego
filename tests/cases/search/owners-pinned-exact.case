# select:file.owners runs its own job with no file cap, so a pinned answer is
# exact.
args: search 'repo:example.com/app@v1 select:file.owners NewRouter'
exit: 0
--- stdout
2 files  1 repo  0.4 s
query  repo:example.com/app@v1 select:file.owners NewRouter

example.com/app@0123456789ab:a.go
example.com/app@0123456789ab:b.go
--- request Search {"query":"repo:example.com/app@v1 select:file.owners NewRouter"}
--- query
query Search($query: String!) {
  search(query: $query, version: V3, patternType: keyword) {
    results {
      matchCount approximateResultCount limitHit
      timedout { name }
      alert { title description kind proposedQueries { description query } }
      elapsedMilliseconds
      dynamicFilters { value count kind }
      results {
        __typename
        ... on FileMatch {
          repository { name }
          file { path commit { oid } }
          revSpec { ... on GitRevSpecExpr { expr } }
          chunkMatches { content contentStart { line }
            ranges { start { line character } end { line character } } }
          symbols { name kind containerName location { range { start { line } } } }
        }
        ... on CommitSearchResult {
          commit { oid subject author { date person { displayName } } repository { name } }
          matches { body { text } highlights { line character length } }
        }
        ... on Repository { name }
      }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "search": {
      "results": {
        "alert": null,
        "approximateResultCount": "2",
        "dynamicFilters": [],
        "elapsedMilliseconds": 400,
        "limitHit": false,
        "matchCount": 2,
        "results": [
          {
            "__typename": "FileMatch",
            "chunkMatches": [],
            "file": {
              "commit": {
                "oid": "0123456789abcdef0123456789abcdef01234567"
              },
              "path": "a.go"
            },
            "repository": {
              "name": "example.com/app"
            },
            "revSpec": {
              "expr": "v1"
            },
            "symbols": []
          },
          {
            "__typename": "FileMatch",
            "chunkMatches": [],
            "file": {
              "commit": {
                "oid": "0123456789abcdef0123456789abcdef01234567"
              },
              "path": "b.go"
            },
            "repository": {
              "name": "example.com/app"
            },
            "revSpec": {
              "expr": "v1"
            },
            "symbols": []
          }
        ],
        "timedout": []
      }
    }
  }
}
