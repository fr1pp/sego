# A query with control characters, given as the argument, is escaped in the error for a search that matches no repository.
args: search $'repo:a\eb\u{202e}c\u{200b}d\ne\rf\0g\u{2028}h\x7fi'
exit: 1
--- stderr
sego: error: No repositories found
  the server proposes: a\u{1b}b\u{202e}c\u{200b}d e\u{d}f\u{0}g\u{2028}h\u{7f}i
  the server proposes: a\u{1b}b\u{202e}c\u{200b}d e\u{d}f\u{0}g\u{2028}h\u{7f}ix
--- request Search {"query":"repo:a\u001bb‮c​d\ne\rf\u0000g hi","unindexed":"repo:a\u001bb‮c​d type:file select:file index:only patterntype:regexp ^NOT-INDEXED:\\ (exceeds\\ the\\ maximum\\ size\\ limit|contains\\ too\\ many\\ trigrams)$ count:all timeout:20s"}
--- query
query Search($query: String!, $unindexed: String!) {
  search(query: $query, version: V3, patternType: keyword) {
    results {
      matchCount approximateResultCount limitHit
      timedout { name }
      alert { title description kind proposedQueries { description query } }
      elapsedMilliseconds
      dynamicFilters { value count kind }
      results {
        __typename
        ... on FileMatch {
          repository { name }
          file { path commit { oid } }
          revSpec { ... on GitRevSpecExpr { expr } }
          chunkMatches { content contentStart { line }
            ranges { start { line character } end { line character } } }
          symbols { name kind containerName location { range { start { line } } } }
        }
        ... on CommitSearchResult {
          commit { oid subject author { date person { displayName } } repository { name } }
          matches { body { text } highlights { line character length } }
        }
        ... on Repository { name }
      }
    }
  }
  unindexed: search(query: $unindexed, version: V3, patternType: keyword) {
    results {
      limitHit elapsedMilliseconds timedout { name } alert { title }
      results { ... on FileMatch { repository { name } file { path byteSize commit { oid } } } }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "search": {
      "results": {
        "alert": {
          "description": "a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi",
          "kind": null,
          "proposedQueries": [
            {
              "description": "a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi",
              "query": "a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi"
            },
            {
              "description": "a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi",
              "query": "a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fix"
            }
          ],
          "title": "No repositories found"
        },
        "approximateResultCount": "a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi",
        "dynamicFilters": [],
        "elapsedMilliseconds": 100,
        "limitHit": false,
        "matchCount": 0,
        "results": [],
        "timedout": []
      }
    }
  }
}
