                },
                "highlights": [
                  {
                    "character": 0,
                    "length": 3,
                    "line": 1
                  },
                  {
                    "character": 0,
                    "length": 3,
                    "line": 2
                  }
                ]
              }
            ]
          },
          {
            "__typename": "CommitSearchResult",
            "commit": {
              "author": {
                "date": "2024-05-06T07:08:09Z",
                "person": {
                  "displayName": "Ann"
                }
              },
              "oid": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
              "repository": {
                "name": "example.com/app"
              },
              "subject": "fix the printer"
            },
            "matches": [
              {
                "body": {
                  "text": "```\nfix the printer\nfix the cache\nfix docs\n```"
                },
                "highlights": [
                  {
                    "character": 0,
                    "length": 3,
                    "line": 1
                  },
                  {
                    "character": 0,
