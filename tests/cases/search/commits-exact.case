# A commit answer under the cap counts its commits, not the highlights the
# server counted, and is exact.
args: search 'repo:example.com/app type:commit fix count:30'
exit: 0
--- stdout
2 commits  1 repo  0.1 s
query  repo:example.com/app type:commit fix count:30

example.com/app@aaaaaaaaaaaa  2024-05-06  Ann  fix the parser
    fix the parser
    fix the lexer

example.com/app@bbbbbbbbbbbb  2024-05-06  Ann  fix the printer
    fix the printer
    fix the cache
    fix docs
--- request Search {"query":"repo:example.com/app type:commit fix count:30"}
--- query
query Search($query: String!) {
  search(query: $query, version: V3, patternType: keyword) {
    results {
      matchCount approximateResultCount limitHit
      timedout { name }
      alert { title description kind proposedQueries { description query } }
      elapsedMilliseconds
      dynamicFilters { value count kind }
      results {
        __typename
        ... on FileMatch {
          repository { name }
          file { path commit { oid } }
          revSpec { ... on GitRevSpecExpr { expr } }
          chunkMatches { content contentStart { line }
            ranges { start { line character } end { line character } } }
          symbols { name kind containerName location { range { start { line } } } }
        }
        ... on CommitSearchResult {
          commit { oid subject author { date person { displayName } } repository { name } }
          matches { body { text } highlights { line character length } }
        }
        ... on Repository { name }
      }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "search": {
      "results": {
        "alert": null,
        "approximateResultCount": "5",
        "dynamicFilters": [],
        "elapsedMilliseconds": 100,
        "limitHit": false,
        "matchCount": 5,
        "results": [
          {
            "__typename": "CommitSearchResult",
            "commit": {
