# A zero whose placeholders used up the cap is at least, so the widen line stays
# out.
args: search 'lang:javascript Foo count:2'
exit: 0
--- stdout
0+ matches  0.1 s
query  lang:javascript Foo count:2
--- request Search {"query":"lang:javascript Foo count:2"}
--- query
query Search($query: String!) {
  search(query: $query, version: V3, patternType: keyword) {
    results {
      matchCount approximateResultCount limitHit
      timedout { name }
      alert { title description kind proposedQueries { description query } }
      elapsedMilliseconds
      dynamicFilters { value count kind }
      results {
        __typename
        ... on FileMatch {
          repository { name }
          file { path commit { oid } }
          revSpec { ... on GitRevSpecExpr { expr } }
          chunkMatches { content contentStart { line }
            ranges { start { line character } end { line character } } }
          symbols { name kind containerName location { range { start { line } } } }
        }
        ... on CommitSearchResult {
          commit { oid subject author { date person { displayName } } repository { name } }
          matches { body { text } highlights { line character length } }
        }
        ... on Repository { name }
      }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "search": {
      "results": {
        "alert": null,
        "approximateResultCount": "2",
        "dynamicFilters": [
          {
            "count": 4,
            "kind": "utility",
            "value": "fork:yes"
          }
        ],
        "elapsedMilliseconds": 100,
        "limitHit": true,
        "matchCount": 2,
        "results": [
          {
            "__typename": "FileMatch",
            "chunkMatches": [
              {
                "content": "NOT-INDEXED: exceeds the maximum size limit",
                "contentStart": {
                  "line": 0
                },
                "ranges": [
                  {
                    "end": {
                      "character": 3,
                      "line": 0
                    },
                    "start": {
                      "character": 0,
                      "line": 0
                    }
                  },
                  {
                    "end": {
                      "character": 3,
                      "line": 0
                    },
                    "start": {
                      "character": 0,
                      "line": 0
                    }
                  }
                ]
              }
            ],
            "file": {
              "commit": {
                "oid": "0123456789abcdef0123456789abcdef01234567"
              },
              "path": "big.js"
            },
            "repository": {
              "name": "example.com/acme/widget"
            },
            "revSpec": null,
            "symbols": []
          }
        ],
        "timedout": []
      }
    }
  }
}
