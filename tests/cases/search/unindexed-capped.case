# A capped answer is a lower bound, so it gets no unindexed-files note.
args: search 'repo:sego-fake/cap zzq'
exit: 0
--- stdout
1+ matches  1 repo  0.3 s
query  repo:sego-fake/cap zzq

github.com/sego-fake/cap
--- request Search {"query":"repo:sego-fake/cap zzq","unindexed":"repo:sego-fake/cap type:file select:file index:only patterntype:regexp ^NOT-INDEXED:\\ (exceeds\\ the\\ maximum\\ size\\ limit|contains\\ too\\ many\\ trigrams)$ count:all timeout:20s"}
--- query
query Search($query: String!, $unindexed: String!) {
  search(query: $query, version: V3, patternType: keyword) {
    results {
      matchCount approximateResultCount limitHit
      timedout { name }
      alert { title description kind proposedQueries { description query } }
      elapsedMilliseconds
      dynamicFilters { value count kind }
      results {
        __typename
        ... on FileMatch {
          repository { name }
          file { path commit { oid } }
          revSpec { ... on GitRevSpecExpr { expr } }
          chunkMatches { content contentStart { line }
            ranges { start { line character } end { line character } } }
          symbols { name kind containerName location { range { start { line } } } }
        }
        ... on CommitSearchResult {
          commit { oid subject author { date person { displayName } } repository { name } }
          matches { body { text } highlights { line character length } }
        }
        ... on Repository { name }
      }
    }
  }
  unindexed: search(query: $unindexed, version: V3, patternType: keyword) {
    results {
      limitHit elapsedMilliseconds timedout { name } alert { title }
      results { ... on FileMatch { repository { name } file { path byteSize commit { oid } } } }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "search": {
      "results": {
        "alert": null,
        "approximateResultCount": "1",
        "dynamicFilters": [],
        "elapsedMilliseconds": 300,
        "limitHit": true,
        "matchCount": 1,
        "results": [
          {
            "__typename": "Repository",
            "name": "github.com/sego-fake/cap"
          }
        ],
        "timedout": []
      }
    },
    "unindexed": {
      "results": {
        "alert": null,
        "elapsedMilliseconds": 10,
        "limitHit": false,
        "results": [
          {
            "file": {
              "byteSize": 2000000,
              "commit": {
                "oid": "1111111111111111111111111111111111111111"
              },
              "path": "big.sql"
            },
            "repository": {
              "name": "github.com/sego-fake/cap"
            }
          }
        ],
        "timedout": []
      }
    }
  }
}
