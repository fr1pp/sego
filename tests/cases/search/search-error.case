# The error shape was returned live on 2026-10-07; the query no longer
# reproduces it.
# The server answers with an error at [search, results].
args: search 'repo:^github\.com/gorilla/mux$@v1.8.0:^v1.7.4 NewRouter'
exit: 1
--- stderr
sego: error: Sourcegraph failed to answer the search
--- request Search {"query":"repo:^github\\.com/gorilla/mux$@v1.8.0:^v1.7.4 NewRouter"}
--- query
query Search($query: String!) {
  search(query: $query, version: V3, patternType: keyword) {
    results {
      matchCount approximateResultCount limitHit
      timedout { name }
      alert { title description kind proposedQueries { description query } }
      elapsedMilliseconds
      dynamicFilters { value count kind }
      results {
        __typename
        ... on FileMatch {
          repository { name }
          file { path commit { oid } }
          revSpec { ... on GitRevSpecExpr { expr } }
          chunkMatches { content contentStart { line }
            ranges { start { line character } end { line character } } }
          symbols { name kind containerName location { range { start { line } } } }
        }
        ... on CommitSearchResult {
          commit { oid subject author { date person { displayName } } repository { name } }
          matches { body { text } highlights { line character length } }
        }
        ... on Repository { name }
      }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "search": null
  },
  "errors": [
    {
      "message": "rpc error: code = Unknown desc = ResolveRevision: got bad commit \"^75dcda0896e109a2a22c9315bca3bb21b87b2ba5\" for repo ID 1700 at revision \"^v1.7.4^0\"",
      "path": [
        "search",
        "results"
      ]
    }
  ]
}
