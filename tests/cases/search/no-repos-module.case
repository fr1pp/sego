# A Go module path as the repository: the fact names the repository's name
# segment.
args: search 'repo:^github\.com/sego-fake/pgx/v5$@v5.5.5 "conn busy"'
exit: 1
--- stderr
sego: error: No repositories found
  sego search 'repo:pgx type:repo' lists the matching repositories
--- request Search {"query":"repo:^github\\.com/sego-fake/pgx/v5$@v5.5.5 \"conn busy\""}
--- query
query Search($query: String!) {
  search(query: $query, version: V3, patternType: keyword) {
    results {
      matchCount approximateResultCount limitHit
      timedout { name }
      alert { title description kind proposedQueries { description query } }
      elapsedMilliseconds
      dynamicFilters { value count kind }
      results {
        __typename
        ... on FileMatch {
          repository { name }
          file { path commit { oid } }
          revSpec { ... on GitRevSpecExpr { expr } }
          chunkMatches { content contentStart { line }
            ranges { start { line character } end { line character } } }
          symbols { name kind containerName location { range { start { line } } } }
        }
        ... on CommitSearchResult {
          commit { oid subject author { date person { displayName } } repository { name } }
          matches { body { text } highlights { line character length } }
        }
        ... on Repository { name }
      }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "search": {
      "results": {
        "alert": {
          "description": "Try using a different `repo:<regexp>` filter to see results",
          "kind": null,
          "proposedQueries": null,
          "title": "No repositories found"
        },
        "approximateResultCount": "0",
        "dynamicFilters": [],
        "elapsedMilliseconds": 36,
        "limitHit": false,
        "matchCount": 0,
        "results": [],
        "timedout": []
      }
    }
  }
}
