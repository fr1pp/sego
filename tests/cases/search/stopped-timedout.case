# Zero results with timed-out repositories: an error that names none of them.
args: search 'repo:sego-fake/timedout foo'
exit: 1
--- stderr
sego: error: the search stopped at 1.2 s with no results
--- request Search {"query":"repo:sego-fake/timedout foo","unindexed":"repo:sego-fake/timedout type:file select:file index:only patterntype:regexp ^NOT-INDEXED:\\ (exceeds\\ the\\ maximum\\ size\\ limit|contains\\ too\\ many\\ trigrams)$ count:all timeout:20s"}
--- query
query Search($query: String!, $unindexed: String!) {
  search(query: $query, version: V3, patternType: keyword) {
    results {
      matchCount approximateResultCount limitHit
      timedout { name }
      alert { title description kind proposedQueries { description query } }
      elapsedMilliseconds
      dynamicFilters { value count kind }
      results {
        __typename
        ... on FileMatch {
          repository { name }
          file { path commit { oid } }
          revSpec { ... on GitRevSpecExpr { expr } }
          chunkMatches { content contentStart { line }
            ranges { start { line character } end { line character } } }
          symbols { name kind containerName location { range { start { line } } } }
        }
        ... on CommitSearchResult {
          commit { oid subject author { date person { displayName } } repository { name } }
          matches { body { text } highlights { line character length } }
        }
        ... on Repository { name }
      }
    }
  }
  unindexed: search(query: $unindexed, version: V3, patternType: keyword) {
    results {
      limitHit elapsedMilliseconds timedout { name } alert { title }
      results { ... on FileMatch { repository { name } file { path byteSize commit { oid } } } }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "search": {
      "results": {
        "alert": null,
        "approximateResultCount": "0",
        "dynamicFilters": [],
        "elapsedMilliseconds": 1200,
        "limitHit": false,
        "matchCount": 0,
        "results": [],
        "timedout": [
          {
            "name": "github.com/sego-fake/t1"
          },
          {
            "name": "github.com/sego-fake/t2"
          },
          {
            "name": "github.com/sego-fake/t3"
          },
          {
            "name": "github.com/sego-fake/t4"
          },
          {
            "name": "github.com/sego-fake/t5"
          },
          {
            "name": "github.com/sego-fake/t6"
          },
          {
            "name": "github.com/sego-fake/t7"
          }
        ]
      }
    },
    "unindexed": {
      "results": {
        "alert": null,
        "elapsedMilliseconds": 10,
        "limitHit": false,
        "results": [],
        "timedout": []
      }
    }
  }
}
