# select:file.directory returns directories, and the root as ./.
args: search 'repo:^github\.com/gorilla/websocket$@v1.5.3 select:file.directory upgrade'
exit: 0
--- stdout
4+ directories  1 repo  0.6 s
query  repo:^github\.com/gorilla/websocket$@v1.5.3 select:file.directory upgrade

github.com/gorilla/websocket@ce903f6d1d96:examples/chat/
github.com/gorilla/websocket@ce903f6d1d96:examples/echo/
github.com/gorilla/websocket@ce903f6d1d96:examples/command/
github.com/gorilla/websocket@ce903f6d1d96:./
--- stderr
sego: note: at a pinned revision, select: keeps only what each repository's first 30 matches hold; count:all gives every one
--- request Search {"query":"repo:^github\\.com/gorilla/websocket$@v1.5.3 select:file.directory upgrade"}
--- query
query Search($query: String!) {
  search(query: $query, version: V3, patternType: keyword) {
    results {
      matchCount approximateResultCount limitHit
      timedout { name }
      alert { title description kind proposedQueries { description query } }
      elapsedMilliseconds
      dynamicFilters { value count kind }
      results {
        __typename
        ... on FileMatch {
          repository { name }
          file { path commit { oid } }
          revSpec { ... on GitRevSpecExpr { expr } }
          chunkMatches { content contentStart { line }
            ranges { start { line character } end { line character } } }
          symbols { name kind containerName location { range { start { line } } } }
        }
        ... on CommitSearchResult {
          commit { oid subject author { date person { displayName } } repository { name } }
          matches { body { text } highlights { line character length } }
        }
        ... on Repository { name }
      }
    }
  }
}
