# A commit search prints the commit line and the message lines around each
# highlight.
args: search 'repo:^github\.com/gorilla/mux$@v1.8.0 type:commit wildcard'
exit: 0
--- stdout
1 commit  1 repo  0.0 s
query  repo:^github\.com/gorilla/mux$@v1.8.0 type:commit wildcard

github.com/gorilla/mux@98cb6bf42e08  2020-07-11  Harshavardhana  fix: regression in vars extract for wildcard host (#579)
    fix: regression in vars extract for wildcard host (#579)
    
--- request Search {"query":"repo:^github\\.com/gorilla/mux$@v1.8.0 type:commit wildcard"}
--- query
query Search($query: String!) {
  search(query: $query, version: V3, patternType: keyword) {
    results {
      matchCount approximateResultCount limitHit
      timedout { name }
      alert { title description kind proposedQueries { description query } }
      elapsedMilliseconds
      dynamicFilters { value count kind }
      results {
        __typename
        ... on FileMatch {
          repository { name }
          file { path commit { oid } }
          revSpec { ... on GitRevSpecExpr { expr } }
          chunkMatches { content contentStart { line }
            ranges { start { line character } end { line character } } }
          symbols { name kind containerName location { range { start { line } } } }
        }
        ... on CommitSearchResult {
          commit { oid subject author { date person { displayName } } repository { name } }
          matches { body { text } highlights { line character length } }
        }
        ... on Repository { name }
      }
    }
  }
}
