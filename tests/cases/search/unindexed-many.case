# A zero lists the text files in scope the index doesn't hold: 3 of 5, across
# two repositories.
args: search 'repo:sego-fake/ux zzq'
exit: 0
--- stdout
0 matches  0.2 s
query  repo:sego-fake/ux zzq
--- stderr
sego: note: the contents of 5 files in scope aren't in the search index (3 over 1 MiB, 2 too many distinct trigrams):
  github.com/sego-fake/ux@111111111111:docs/huge.txt  7.0 MiB
  github.com/sego-fake/ux@111111111111:data/dump.sql  3.3 MiB
  github.com/sego-fake/uy@222222222222:vendor/big.js  1.1 MiB
  … (+2 more files; --json has the full list)
--- request Search {"query":"repo:sego-fake/ux zzq","unindexed":"repo:sego-fake/ux type:file select:file index:only patterntype:regexp ^NOT-INDEXED:\\ (exceeds\\ the\\ maximum\\ size\\ limit|contains\\ too\\ many\\ trigrams)$ count:all timeout:20s"}
--- query
query Search($query: String!, $unindexed: String!) {
  search(query: $query, version: V3, patternType: keyword) {
    results {
      matchCount approximateResultCount limitHit
      timedout { name }
      alert { title description kind proposedQueries { description query } }
      elapsedMilliseconds
      dynamicFilters { value count kind }
      results {
        __typename
        ... on FileMatch {
          repository { name }
          file { path commit { oid } }
          revSpec { ... on GitRevSpecExpr { expr } }
          chunkMatches { content contentStart { line }
            ranges { start { line character } end { line character } } }
          symbols { name kind containerName location { range { start { line } } } }
        }
        ... on CommitSearchResult {
          commit { oid subject author { date person { displayName } } repository { name } }
          matches { body { text } highlights { line character length } }
        }
        ... on Repository { name }
      }
    }
  }
  unindexed: search(query: $unindexed, version: V3, patternType: keyword) {
    results {
      limitHit elapsedMilliseconds timedout { name } alert { title }
      results { ... on FileMatch { repository { name } file { path byteSize commit { oid } } } }
    }
  }
}
