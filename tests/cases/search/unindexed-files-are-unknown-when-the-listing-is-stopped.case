# A listing that names a repository the server stopped searching is incomplete.
args: search 'repo:example.com/acme/widget foo'
exit: 0
--- stdout
0 matches  0.2 s
query  repo:example.com/acme/widget foo
--- stderr
sego: note: the search can't tell which files it skipped; files over 1 MiB and files with too many distinct trigrams are never searched
--- request Search {"query":"repo:example.com/acme/widget foo","unindexed":"repo:example.com/acme/widget type:file select:file index:only patterntype:regexp ^NOT-INDEXED:\\ (exceeds\\ the\\ maximum\\ size\\ limit|contains\\ too\\ many\\ trigrams)$ count:all timeout:20s"}
--- query
query Search($query: String!, $unindexed: String!) {
  search(query: $query, version: V3, patternType: keyword) {
    results {
      matchCount approximateResultCount limitHit
      timedout { name }
      alert { title description kind proposedQueries { description query } }
      elapsedMilliseconds
      dynamicFilters { value count kind }
      results {
        __typename
        ... on FileMatch {
          repository { name }
          file { path commit { oid } }
          revSpec { ... on GitRevSpecExpr { expr } }
          chunkMatches { content contentStart { line }
            ranges { start { line character } end { line character } } }
          symbols { name kind containerName location { range { start { line } } } }
        }
        ... on CommitSearchResult {
          commit { oid subject author { date person { displayName } } repository { name } }
          matches { body { text } highlights { line character length } }
        }
        ... on Repository { name }
      }
    }
  }
  unindexed: search(query: $unindexed, version: V3, patternType: keyword) {
    results {
      limitHit elapsedMilliseconds timedout { name } alert { title }
      results { ... on FileMatch { repository { name } file { path byteSize commit { oid } } } }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "search": {
      "results": {
        "alert": null,
        "approximateResultCount": "0",
        "dynamicFilters": [],
        "elapsedMilliseconds": 200,
        "limitHit": false,
        "matchCount": 0,
        "results": [],
        "timedout": []
      }
    },
    "unindexed": {
      "results": {
        "alert": null,
        "elapsedMilliseconds": 10,
        "limitHit": false,
        "results": [
          {
            "file": {
              "byteSize": 2000000,
              "commit": {
                "oid": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
              },
              "path": "big.c"
            },
            "repository": {
              "name": "example.com/acme/widget"
            }
          },
          {},
          {
            "file": {
              "byteSize": 900,
              "commit": {
                "oid": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
              },
              "path": "dense.txt"
            },
            "repository": {
              "name": "example.com/acme/widget"
            }
          }
        ],
        "timedout": [
          {
            "name": "example.com/acme/widget"
          }
        ]
      }
    }
  }
}
