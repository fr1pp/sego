# A diff body with CR line breaks and a blank last line loses both, and a
# highlight on the blank line is dropped.
args: search --json 'repo:example.com/app type:diff foo'
exit: 0
--- stdout
{"query":"repo:example.com/app type:diff foo","pattern_type":"keyword","unit":"commits","count":1,"at_least":false,"stopped":false,"elapsed_ms":100,"limit_ms":20000,"widen":[],"unindexed":null,"alert":null,"results":[{"kind":"commit","repo":"example.com/app","commit":"0123456789abcdef0123456789abcdef01234567","date":"2024-05-06","author":"Ann","subject":"fix","lines":["x","+y"],"highlights":[],"preview_limited":false}],"server":{"match_count":1,"approximate_count":"1","limit_hit":false,"timedout":[]}}
--- request Search {"query":"repo:example.com/app type:diff foo"}
--- query
query Search($query: String!) {
  search(query: $query, version: V3, patternType: keyword) {
    results {
      matchCount approximateResultCount limitHit
      timedout { name }
      alert { title description kind proposedQueries { description query } }
      elapsedMilliseconds
      dynamicFilters { value count kind }
      results {
        __typename
        ... on FileMatch {
          repository { name }
          file { path commit { oid } }
          revSpec { ... on GitRevSpecExpr { expr } }
          chunkMatches { content contentStart { line }
            ranges { start { line character } end { line character } } }
          symbols { name kind containerName location { range { start { line } } } }
        }
        ... on CommitSearchResult {
          commit { oid subject author { date person { displayName } } repository { name } }
          matches { body { text } highlights { line character length } }
        }
        ... on Repository { name }
      }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "search": {
      "results": {
        "alert": null,
        "approximateResultCount": "1",
        "dynamicFilters": [],
        "elapsedMilliseconds": 100,
        "limitHit": false,
        "matchCount": 1,
        "results": [
          {
            "__typename": "CommitSearchResult",
            "commit": {
              "author": {
                "date": "2024-05-06T07:08:09Z",
                "person": {
                  "displayName": "Ann"
                }
              },
              "oid": "0123456789abcdef0123456789abcdef01234567",
              "repository": {
                "name": "example.com/app"
              },
              "subject": "fix"
            },
            "matches": [
              {
                "body": {
                  "text": "```diff\r\nx\r\n+y\r\n\r\n```"
                },
                "highlights": [
                  {
                    "character": 0,
                    "length": 1,
                    "line": 3
                  }
                ]
              }
            ]
          }
        ],
        "timedout": []
      }
    },
    "unindexed": {
      "results": {
        "alert": null,
        "elapsedMilliseconds": 10,
        "limitHit": false,
        "results": [],
        "timedout": []
      }
    }
  }
}
