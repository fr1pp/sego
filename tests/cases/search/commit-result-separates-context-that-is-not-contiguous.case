# A commit prints the message line before and after each highlight; context that
# touches has no separator.
args: search 'repo:example.com/acme/widget type:commit m'
exit: 0
--- stdout
2 commits  1 repo  0.7 s
query  repo:example.com/acme/widget type:commit m

example.com/acme/widget@aaaaaaaaaaaa  2024-05-06  Ann  Fix it
    m1
    m2
--
    m5
    m6
    m7

example.com/acme/widget@bbbbbbbbbbbb  2024-05-06  Ann  Fix it again
    m2
    m3
    m4
    m5
    m6
--- request Search {"query":"repo:example.com/acme/widget type:commit m"}
--- query
query Search($query: String!) {
  search(query: $query, version: V3, patternType: keyword) {
    results {
      matchCount approximateResultCount limitHit
      timedout { name }
      alert { title description kind proposedQueries { description query } }
      elapsedMilliseconds
      dynamicFilters { value count kind }
      results {
        __typename
        ... on FileMatch {
          repository { name }
          file { path commit { oid } }
          revSpec { ... on GitRevSpecExpr { expr } }
          chunkMatches { content contentStart { line }
            ranges { start { line character } end { line character } } }
          symbols { name kind containerName location { range { start { line } } } }
        }
        ... on CommitSearchResult {
          commit { oid subject author { date person { displayName } } repository { name } }
          matches { body { text } highlights { line character length } }
        }
        ... on Repository { name }
      }
    }
  }
}
