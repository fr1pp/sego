# A zero from select:symbol at a pinned revision may have dropped the results
# the cap kept, so it notes the cap.
args: search 'repo:example.com/acme/router@v1 type:symbol /./ select:symbol.method'
exit: 0
--- stdout
0+ symbols  0.1 s
query  repo:example.com/acme/router@v1 type:symbol /./ select:symbol.method
--- stderr
sego: note: at a pinned revision, select: keeps only what each repository's first 30 matches hold; count:all gives every one
--- request Search {"query":"repo:example.com/acme/router@v1 type:symbol /./ select:symbol.method"}
--- query
query Search($query: String!) {
  search(query: $query, version: V3, patternType: keyword) {
    results {
      matchCount approximateResultCount limitHit
      timedout { name }
      alert { title description kind proposedQueries { description query } }
      elapsedMilliseconds
      dynamicFilters { value count kind }
      results {
        __typename
        ... on FileMatch {
          repository { name }
          file { path commit { oid } }
          revSpec { ... on GitRevSpecExpr { expr } }
          chunkMatches { content contentStart { line }
            ranges { start { line character } end { line character } } }
          symbols { name kind containerName location { range { start { line } } } }
        }
        ... on CommitSearchResult {
          commit { oid subject author { date person { displayName } } repository { name } }
          matches { body { text } highlights { line character length } }
        }
        ... on Repository { name }
      }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "search": {
      "results": {
        "alert": null,
        "approximateResultCount": "0",
        "dynamicFilters": [],
        "elapsedMilliseconds": 100,
        "limitHit": false,
        "matchCount": 0,
        "results": [],
        "timedout": []
      }
    }
  }
}
