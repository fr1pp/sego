# Checks 8 and 9: a structural search wider than one file, with no language.
args: search 'repo:sego-fake/st@v1 patterntype:structural foo(...)'
exit: 0
--- stdout
0 matches  0.1 s
query  repo:sego-fake/st@v1 patterntype:structural foo(...)
--- stderr
sego: note: a structural search over more than one file can miss matches without a +; file:^PATH$ makes it complete, and a regex search marks a cut with +
sego: note: with no lang: and no file: extension, a structural search can parse files as the wrong language and miss matches; lang: names the language
sego: note: at a pinned revision the search can't tell which files it skipped; files over 1 MiB are never searched
--- request Search {"query":"repo:sego-fake/st@v1 patterntype:structural foo(...)"}
--- query
query Search($query: String!) {
  search(query: $query, version: V3, patternType: keyword) {
    results {
      matchCount approximateResultCount limitHit
      timedout { name }
      alert { title description kind proposedQueries { description query } }
      elapsedMilliseconds
      dynamicFilters { value count kind }
      results {
        __typename
        ... on FileMatch {
          repository { name }
          file { path commit { oid } }
          revSpec { ... on GitRevSpecExpr { expr } }
          chunkMatches { content contentStart { line }
            ranges { start { line character } end { line character } } }
          symbols { name kind containerName location { range { start { line } } } }
        }
        ... on CommitSearchResult {
          commit { oid subject author { date person { displayName } } repository { name } }
          matches { body { text } highlights { line character length } }
        }
        ... on Repository { name }
      }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "search": {
      "results": {
        "alert": null,
        "approximateResultCount": "0",
        "dynamicFilters": [],
        "elapsedMilliseconds": 100,
        "limitHit": false,
        "matchCount": 0,
        "results": [],
        "timedout": []
      }
    }
  }
}
