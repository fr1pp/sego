# With a repo: filter the widen line is on every answer, an at least one too.
args: search 'repo:example.com/acme/widget foo count:1'
exit: 0
--- stdout
1+ matches  1 repo  0.1 s
query  repo:example.com/acme/widget foo count:1
widen  archived:yes (3 repos)

example.com/acme/widget@0123456789ab:main.go
1:foo
--- request Search {"query":"repo:example.com/acme/widget foo count:1","unindexed":"repo:example.com/acme/widget type:file select:file index:only patterntype:regexp ^NOT-INDEXED:\\ (exceeds\\ the\\ maximum\\ size\\ limit|contains\\ too\\ many\\ trigrams)$ count:all timeout:60s"}
--- query
query Search($query: String!, $unindexed: String!) {
  search(query: $query, version: V3, patternType: keyword) {
    results {
      matchCount approximateResultCount limitHit
      timedout { name }
      alert { title description kind proposedQueries { description query } }
      elapsedMilliseconds
      dynamicFilters { value count kind }
      results {
        __typename
        ... on FileMatch {
          repository { name }
          file { path commit { oid } }
          revSpec { ... on GitRevSpecExpr { expr } }
          chunkMatches { content contentStart { line }
            ranges { start { line character } end { line character } } }
          symbols { name kind containerName location { range { start { line } } } }
        }
        ... on CommitSearchResult {
          commit { oid subject author { date person { displayName } } repository { name } }
          matches { body { text } highlights { line character length } }
        }
        ... on Repository { name }
      }
    }
  }
  unindexed: search(query: $unindexed, version: V3, patternType: keyword) {
    results {
      limitHit elapsedMilliseconds timedout { name } alert { title }
      results { ... on FileMatch { repository { name } file { path byteSize commit { oid } } } }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "search": {
      "results": {
        "alert": null,
        "approximateResultCount": "1",
        "dynamicFilters": [
          {
            "count": 3,
            "kind": "utility",
            "value": "archived:yes"
          }
        ],
        "elapsedMilliseconds": 100,
        "limitHit": true,
        "matchCount": 1,
        "results": [
          {
            "__typename": "FileMatch",
            "chunkMatches": [
              {
                "content": "foo",
                "contentStart": {
                  "line": 0
                },
                "ranges": [
                  {
                    "end": {
                      "character": 3,
                      "line": 0
                    },
                    "start": {
                      "character": 0,
                      "line": 0
                    }
                  }
                ]
              }
            ],
            "file": {
              "commit": {
                "oid": "0123456789abcdef0123456789abcdef01234567"
              },
              "path": "main.go"
            },
            "repository": {
              "name": "example.com/acme/widget"
            },
            "revSpec": null,
            "symbols": []
          }
        ],
        "timedout": []
      }
    },
    "unindexed": {
      "results": {
        "alert": null,
        "elapsedMilliseconds": 10,
        "limitHit": false,
        "results": [],
        "timedout": []
      }
    }
  }
}
