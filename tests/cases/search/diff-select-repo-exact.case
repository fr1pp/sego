# A complete repository answer to a diff search counts repositories, not
# highlights, so it is exact.
args: search 'repo:^example\.com/app$ type:diff select:repo foo count:30'
exit: 0
--- stdout
1 repo  0.4 s
query  repo:^example\.com/app$ type:diff select:repo foo count:30

example.com/app
--- request Search {"query":"repo:^example\\.com/app$ type:diff select:repo foo count:30"}
--- query
query Search($query: String!) {
  search(query: $query, version: V3, patternType: keyword) {
    results {
      matchCount approximateResultCount limitHit
      timedout { name }
      alert { title description kind proposedQueries { description query } }
      elapsedMilliseconds
      dynamicFilters { value count kind }
      results {
        __typename
        ... on FileMatch {
          repository { name }
          file { path commit { oid } }
          revSpec { ... on GitRevSpecExpr { expr } }
          chunkMatches { content contentStart { line }
            ranges { start { line character } end { line character } } }
          symbols { name kind containerName location { range { start { line } } } }
        }
        ... on CommitSearchResult {
          commit { oid subject author { date person { displayName } } repository { name } }
          matches { body { text } highlights { line character length } }
        }
        ... on Repository { name }
      }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "search": {
      "results": {
        "alert": null,
        "approximateResultCount": "1",
        "dynamicFilters": [],
        "elapsedMilliseconds": 400,
        "limitHit": false,
        "matchCount": 1,
        "results": [
          {
            "__typename": "Repository",
            "name": "example.com/app"
          }
        ],
        "timedout": []
      }
    }
  }
}
