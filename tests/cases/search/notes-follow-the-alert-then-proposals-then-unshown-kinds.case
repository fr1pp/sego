# The alert, its proposals and the kinds not shown are notes in that order; a
# count of one is singular.
args: search 'repo:example.com/acme/widget type:repo'
exit: 0
--- stdout
1 repo  0.1 s
query  repo:example.com/acme/widget type:repo

example.com/acme/widget
--- stderr
sego: note: Heads up: text
sego: note: the server proposes: q
sego: note: 2 results of kind NewKind not shown
sego: note: 1 result of kind Other not shown
--- request Search {"query":"repo:example.com/acme/widget type:repo"}
--- query
query Search($query: String!) {
  search(query: $query, version: V3, patternType: keyword) {
    results {
      matchCount approximateResultCount limitHit
      timedout { name }
      alert { title description kind proposedQueries { description query } }
      elapsedMilliseconds
      dynamicFilters { value count kind }
      results {
        __typename
        ... on FileMatch {
          repository { name }
          file { path commit { oid } }
          revSpec { ... on GitRevSpecExpr { expr } }
          chunkMatches { content contentStart { line }
            ranges { start { line character } end { line character } } }
          symbols { name kind containerName location { range { start { line } } } }
        }
        ... on CommitSearchResult {
          commit { oid subject author { date person { displayName } } repository { name } }
          matches { body { text } highlights { line character length } }
        }
        ... on Repository { name }
      }
    }
  }
}
--- response 200 application/json
{
  "data": {
    "search": {
      "results": {
        "alert": {
          "description": "text",
          "kind": null,
          "proposedQueries": [
            {
              "description": null,
              "query": "q"
            }
          ],
          "title": "Heads up"
        },
        "approximateResultCount": "1",
        "dynamicFilters": [],
        "elapsedMilliseconds": 100,
        "limitHit": false,
        "matchCount": 1,
        "results": [
          {
            "__typename": "NewKind"
          },
          {
            "__typename": "Repository",
            "name": "example.com/acme/widget"
          },
          {
            "__typename": "Other"
          },
          {
            "__typename": "NewKind"
          }
        ],
        "timedout": []
      }
    }
  }
}
