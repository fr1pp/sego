# A range in a repository with no commits is an error.
args: log github.com/ascoders/blog@v1..v2
exit: 1
--- stderr
sego: error: github.com/ascoders/blog has no commits
--- request Log {"a":"v1","b":"v2","path":null,"repo0":"github.com/ascoders/blog"}
--- query
query Log($repo0: String!, $a: String!, $b: String!, $path: String) {
  a0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $a) { oid }
  }
  b0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $b) { oid }
  }
  n0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $b) { behindAhead(revspec: $a) { ahead } }
  }
  c0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    comparison(base: $a, head: $b) { commits(first: 151, path: $path) { nodes { oid subject author { date person { displayName } } parents { oid } } pageInfo { hasNextPage } } }
  }
  t0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    gitRefs(type: GIT_TAG, first: 1000) { totalCount nodes { displayName target { oid } } }
  }
}
--- response 200 application/json recorded 2026-10-25 https://sourcegraph.com
{
  "data": {
    "a0": {
      "commit": null,
      "defaultBranch": null,
      "name": "github.com/ascoders/blog"
    },
    "b0": {
      "commit": null,
      "defaultBranch": null,
      "name": "github.com/ascoders/blog"
    },
    "c0": null,
    "n0": {
      "commit": null,
      "defaultBranch": null,
      "name": "github.com/ascoders/blog"
    },
    "t0": {
      "defaultBranch": null,
      "gitRefs": {
        "nodes": [],
        "totalCount": 0
      },
      "name": "github.com/ascoders/blog"
    }
  },
  "errors": [
    {
      "message": "revision not found: repo 714773 @v2^0",
      "path": [
        "c0",
        "comparison"
      ]
    }
  ]
}
