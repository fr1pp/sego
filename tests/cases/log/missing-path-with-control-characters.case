# A missing path with control characters, given as the argument, is escaped in the error.
args: log $'example.com/acme/widget@v2.0.0:a\eb\u{202e}c\u{200b}d\ne\rf\0g\u{2028}h\x7fi-gone'
exit: 1
--- stderr
sego: error: a\u{1b}b\u{202e}c\u{200b}d e\u{d}f\u{0}g\u{2028}h\u{7f}i-gone not found in example.com/acme/widget@0123456789ab
--- request Log {"path":"a\u001bb‮c​d\ne\rf\u0000g hi-gone","repo0":"example.com/acme/widget","rev":"v2.0.0"}
--- query
query Log($repo0: String!, $rev: String!, $path: String) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $rev) { oid ancestors(first: 151, path: $path) { nodes { oid subject author { date person { displayName } } parents { oid } } pageInfo { hasNextPage } } }
  }
  t0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    gitRefs(type: GIT_TAG, first: 1000) { totalCount nodes { displayName target { oid } } }
  }
}
--- response 200 application/json
{
  "data": {
    "r0": {
      "commit": {
        "ancestors": {
          "nodes": [],
          "pageInfo": {
            "hasNextPage": false
          }
        },
        "oid": "0123456789abcdef0123456789abcdef01234567"
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    },
    "t0": {
      "defaultBranch": {
        "displayName": "main"
      },
      "gitRefs": {
        "nodes": [],
        "totalCount": 0
      },
      "name": "example.com/acme/widget"
    }
  }
}
