# A subject past 500 columns is cut in text, with a pointer to JSON.
args: log example.com/acme/widget@v2
exit: 0
--- stdout
example.com/acme/widget@000100010001  1 commit  rev v2
000100010001  2026-08-01  Ada Lovelace  … (+33 more columns; --json has the full line)
--- request Log {"path":null,"repo0":"example.com/acme/widget","rev":"v2"}
--- query
query Log($repo0: String!, $rev: String!, $path: String) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $rev) { oid ancestors(first: 151, path: $path) { nodes { oid subject author { date person { displayName } } parents { oid } } pageInfo { hasNextPage } } }
  }
  t0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    gitRefs(type: GIT_TAG, first: 1000) { totalCount nodes { displayName target { oid } } }
  }
}
--- response 200 application/json
{
  "data": {
    "r0": {
      "commit": {
        "ancestors": {
          "nodes": [
            {
              "author": {
                "date": "2026-08-01T09:00:00Z",
                "person": {
                  "displayName": "Ada Lovelace"
                }
              },
              "oid": "0001000100010001000100010001000100010001",
              "parents": [
                {
                  "oid": "0002000200020002000200020002000200020002"
                }
              ],
              "subject": ""
            }
          ],
          "pageInfo": {
            "hasNextPage": false
          }
        },
        "oid": "0001000100010001000100010001000100010001"
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    },
    "t0": {
      "defaultBranch": {
        "displayName": "main"
      },
      "gitRefs": {
        "nodes": [],
        "totalCount": 0
      },
      "name": "example.com/acme/widget"
    }
  }
}
