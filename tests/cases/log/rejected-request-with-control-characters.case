# The server's message for a rejected request is escaped in the error.
args: log example.com/acme/widget@v2.0.0
exit: 1
--- stderr
sego: error: Sourcegraph rejected sego's request: a\u{1b}b\u{202e}c\u{200b}d e\u{d}f\u{0}g\u{2028}h\u{7f}i
--- request Log {"path":null,"repo0":"example.com/acme/widget","rev":"v2.0.0"}
--- query
query Log($repo0: String!, $rev: String!, $path: String) {
  r0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $rev) { oid ancestors(first: 151, path: $path) { nodes { oid subject author { date person { displayName } } parents { oid } } pageInfo { hasNextPage } } }
  }
  t0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    gitRefs(type: GIT_TAG, first: 1000) { totalCount nodes { displayName target { oid } } }
  }
}
--- response 200 application/json
{
  "data": null,
  "errors": [
    {
      "message": "a\u001bb\u202ec\u200bd\ne\rf\u0000g\u2028h\u007fi"
    }
  ]
}
