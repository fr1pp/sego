# A range between two commit ids has no rev field in its header.
args: log example.com/acme/widget@0123456789ab..456789abcdef
exit: 0
--- stdout
example.com/acme/widget@0123456789ab..456789abcdef  1 commit
456789abcdef  2026-09-14  Ada Lovelace  Add the widget
--- request Log {"a":"0123456789ab","b":"456789abcdef","path":null,"repo0":"example.com/acme/widget"}
--- query
query Log($repo0: String!, $a: String!, $b: String!, $path: String) {
  a0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $a) { oid }
  }
  b0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $b) { oid }
  }
  n0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $b) { behindAhead(revspec: $a) { ahead } }
  }
  c0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    comparison(base: $a, head: $b) { commits(first: 151, path: $path) { nodes { oid subject author { date person { displayName } } parents { oid } } pageInfo { hasNextPage } } }
  }
  t0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    gitRefs(type: GIT_TAG, first: 1000) { totalCount nodes { displayName target { oid } } }
  }
}
--- response 200 application/json
{
  "data": {
    "a0": {
      "commit": {
        "oid": "0123456789abcdef0123456789abcdef01234567"
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    },
    "b0": {
      "commit": {
        "oid": "456789abcdef0123456789abcdef0123456789ab"
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    },
    "c0": {
      "comparison": {
        "commits": {
          "nodes": [
            {
              "author": {
                "date": "2026-09-14T10:00:00Z",
                "person": {
                  "displayName": "Ada Lovelace"
                }
              },
              "oid": "456789abcdef0123456789abcdef0123456789ab",
              "parents": [
                {
                  "oid": "0123456789abcdef0123456789abcdef01234567"
                }
              ],
              "subject": "Add the widget"
            }
          ],
          "pageInfo": {
            "hasNextPage": false
          }
        }
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    },
    "n0": {
      "commit": {
        "behindAhead": {
          "ahead": 1
        }
      },
      "defaultBranch": {
        "displayName": "main"
      },
      "name": "example.com/acme/widget"
    },
    "t0": {
      "defaultBranch": {
        "displayName": "main"
      },
      "gitRefs": {
        "nodes": [],
        "totalCount": 0
      },
      "name": "example.com/acme/widget"
    }
  }
}
