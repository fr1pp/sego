# A range of one commit says commit in the singular.
args: log github.com/gorilla/context@a45ea70b19f4..6a490e2f9d52
exit: 0
--- stdout
github.com/gorilla/context@a45ea70b19f4..6a490e2f9d52  1 commit
6a490e2f9d52  2023-10-18  Corey Daley  (tag: v2.0.0, tag: v1.1.2) Updating github actions workflows to test 1.20 and 1.21 (#45)
--- request Log {"a":"a45ea70b19f4","b":"6a490e2f9d52","path":null,"repo0":"github.com/gorilla/context"}
--- query
query Log($repo0: String!, $a: String!, $b: String!, $path: String) {
  a0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $a) { oid }
  }
  b0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $b) { oid }
  }
  n0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    commit(rev: $b) { behindAhead(revspec: $a) { ahead } }
  }
  c0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    comparison(base: $a, head: $b) { commits(first: 151, path: $path) { nodes { oid subject author { date person { displayName } } parents { oid } } pageInfo { hasNextPage } } }
  }
  t0: repository(name: $repo0) {
    name
    defaultBranch { displayName }
    gitRefs(type: GIT_TAG, first: 1000) { totalCount nodes { displayName target { oid } } }
  }
}
