#!/bin/sh
set -eu

version=17.0.0
url="https://www.unicode.org/Public/$version/ucd/DerivedCoreProperties.txt"
sha256=24c7fed1195c482faaefd5c1e7eb821c5ee1fb6de07ecdbaa64b56a99da22c08

cd "$(dirname "$0")/.."
mkdir -p target
data=target/DerivedCoreProperties.txt
curl -sSfL --remove-on-error -A "sego-dev/0" "$url" -o "$data"
if command -v sha256sum >/dev/null; then
    digest=$(sha256sum <"$data")
else
    digest=$(shasum -a 256 <"$data")
fi
digest=${digest%% *}
if [ "$digest" != "$sha256" ]; then
    echo "error: $url has SHA-256 $digest, expected $sha256" >&2
    exit 1
fi

if ! awk -v version="$version" -v q="'" '
function parse_hex(s,    i, n) {
    s = tolower(s)
    n = 0
    for (i = 1; i <= length(s); i++)
        n = n * 16 + index("0123456789abcdef", substr(s, i, 1)) - 1
    return n
}
function add(first, last,    c) {
    last = parse_hex(last)
    for (c = parse_hex(first); c <= last; c++)
        unsafe[c] = 1
}
function remove(first, last,    c) {
    last = parse_hex(last)
    for (c = parse_hex(first); c <= last; c++)
        delete unsafe[c]
}
function char(c) {
    return sprintf(q "\\u{%x}" q, c)
}
function trim(s) {
    gsub(/^[ \t]+|[ \t]+$/, "", s)
    return s
}
{
    sub(/#.*/, "")
    if (split($0, fields, ";") != 2 || trim(fields[2]) != "Default_Ignorable_Code_Point")
        next
    if (split(trim(fields[1]), bounds, /\.\./) == 1)
        bounds[2] = bounds[1]
    add(bounds[1], bounds[2])
}
END {
    # The zero-width joiner and variation selectors stay, so most emoji print
    # as themselves; tag sequences such as subdivision flags are escaped.
    remove("200D", "200D")
    remove("FE00", "FE0F")
    remove("E0100", "E01EF")
    add("00", "08")
    add("0A", "1F")
    add("7F", "9F")
    add("2028", "2029")

    print "// Generated by `just escape-table` from Unicode " version
    print "// DerivedCoreProperties.txt. Do not edit."
    print "//"
    print "// The characters sego never prints as themselves, as sorted, merged,"
    print "// inclusive ranges: C0 controls except tab, DEL, C1 controls, U+2028,"
    print "// U+2029, and every Default_Ignorable_Code_Point except U+200D,"
    print "// U+FE00..U+FE0F and U+E0100..U+E01EF."
    print "pub const UNSAFE: &[(char, char)] = &["
    # Runs one past the last code point, so a range that ends there is closed.
    past = parse_hex("10FFFF") + 1
    for (c = 0; c <= past; c++) {
        if (c in unsafe) {
            if (!open) { first = c; open = 1 }
        } else if (open) {
            print "    (" char(first) ", " char(c - 1) "),"
            open = 0
        }
    }
    print "];"
}
' "$data" >target/table.rs.part; then
    rm -f target/table.rs.part
    exit 1
fi
mv target/table.rs.part src/escape/table.rs
