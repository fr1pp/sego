set shell := ["bash", "-euo", "pipefail", "-c"]

# Format check, lints with warnings as errors, and the offline tests.
check:
    cargo fmt --check
    cargo clippy --all-targets -- -D warnings
    cargo test

# `check` with snapshot updates refused, then fail if anything tracked changed.
ci:
    if [[ -n "${UPDATE_EXPECT:-}" ]]; then echo "error: unset UPDATE_EXPECT for ci" >&2; exit 1; fi
    just check
    git diff --exit-code

# Regenerate src/escape/table.rs from the pinned Unicode data.
escape-table:
    #!/usr/bin/env -S uv run --script
    # /// script
    # requires-python = ">=3.11"
    # dependencies = []
    # ///
    import hashlib
    import sys
    import urllib.request
    from pathlib import Path

    VERSION = "17.0.0"
    URL = f"https://www.unicode.org/Public/{VERSION}/ucd/DerivedCoreProperties.txt"
    SHA256 = "24c7fed1195c482faaefd5c1e7eb821c5ee1fb6de07ecdbaa64b56a99da22c08"


    def inclusive(first, last):
        return set(range(first, last + 1))


    def char(c):
        return "'\\u{%x}'" % c


    with urllib.request.urlopen(URL) as response:
        data = response.read()
    digest = hashlib.sha256(data).hexdigest()
    if digest != SHA256:
        sys.exit(f"error: {URL} has SHA-256 {digest}, expected {SHA256}")

    ignorable = set()
    for line in data.decode().splitlines():
        fields = [field.strip() for field in line.split("#")[0].split(";")]
        if fields[1:] == ["Default_Ignorable_Code_Point"]:
            first, _, last = fields[0].partition("..")
            ignorable |= inclusive(int(first, 16), int(last or first, 16))

    # The zero-width joiner and variation selectors stay, so emoji print as
    # themselves.
    kept = {0x200D} | inclusive(0xFE00, 0xFE0F) | inclusive(0xE0100, 0xE01EF)
    unsafe = (
        inclusive(0x00, 0x08)
        | inclusive(0x0A, 0x1F)
        | inclusive(0x7F, 0x9F)
        | {0x2028, 0x2029}
        | (ignorable - kept)
    )

    ranges = []
    for c in sorted(unsafe):
        if ranges and ranges[-1][1] == c - 1:
            ranges[-1][1] = c
        else:
            ranges.append([c, c])
    rows = "".join(f"    ({char(a)}, {char(b)}),\n" for a, b in ranges)

    Path("src/escape/table.rs").write_text(f"""\
    // Generated by `just escape-table` from Unicode {VERSION}
    // DerivedCoreProperties.txt. Do not edit.
    //
    // The characters sego never prints as themselves, as sorted, merged,
    // inclusive ranges: C0 controls except tab, DEL, C1 controls, U+2028,
    // U+2029, and every Default_Ignorable_Code_Point except U+200D,
    // U+FE00..U+FE0F and U+E0100..U+E01EF.
    pub const UNSAFE: &[(char, char)] = &[
    {rows}];
    """)

# Rebuild every capture's request from sego's own plans, send it, and rewrite the file.
capture:
    cargo test --bin sego capture -- --ignored --test-threads=1

# Live tests, re-captured responses, and a drift check.
live:
    cargo test --test integration live -- --ignored
    just capture
    just drift

# Fail if a re-captured response changed in anything but server-measured times.
drift:
    #!/usr/bin/env bash
    set -euo pipefail
    strip='walk(if type == "object" then del(.elapsedMilliseconds) else . end)'
    status=0
    for f in $(git diff --name-only -- 'tests/*/*.json'); do
        if cmp -s <(git show "HEAD:$f" | jq -S "$strip") <(jq -S "$strip" "$f"); then
            git checkout -- "$f"
        else
            echo "drift: $f" >&2; status=1
        fi
    done
    exit "$status"
