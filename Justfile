set shell := ["bash", "-euo", "pipefail", "-c"]

# Format check, lints with warnings as errors, and the offline tests.
check:
    cargo fmt --check
    cargo clippy --all-targets -- -D warnings
    cargo test

# `check` with snapshot updates refused, then fail if anything tracked changed.
ci:
    if [[ -n "${UPDATE_EXPECT:-}" ]]; then echo "error: unset UPDATE_EXPECT for ci" >&2; exit 1; fi
    just check
    git diff --exit-code

# Regenerate src/escape/table.rs from the pinned Unicode data.
escape-table:
    #!/usr/bin/env -S uv run --script
    # /// script
    # requires-python = ">=3.11"
    # dependencies = []
    # ///
    import hashlib
    import sys
    import urllib.request
    from pathlib import Path

    VERSION = "17.0.0"
    URL = f"https://www.unicode.org/Public/{VERSION}/ucd/DerivedCoreProperties.txt"
    SHA256 = "24c7fed1195c482faaefd5c1e7eb821c5ee1fb6de07ecdbaa64b56a99da22c08"


    def inclusive(first, last):
        return set(range(first, last + 1))


    def char(c):
        return "'\\u{%x}'" % c


    with urllib.request.urlopen(URL) as response:
        data = response.read()
    digest = hashlib.sha256(data).hexdigest()
    if digest != SHA256:
        sys.exit(f"error: {URL} has SHA-256 {digest}, expected {SHA256}")

    ignorable = set()
    for line in data.decode().splitlines():
        fields = [field.strip() for field in line.split("#")[0].split(";")]
        if fields[1:] == ["Default_Ignorable_Code_Point"]:
            first, _, last = fields[0].partition("..")
            ignorable |= inclusive(int(first, 16), int(last or first, 16))

    # The zero-width joiner and variation selectors stay, so most emoji print
    # as themselves; tag sequences such as subdivision flags are escaped.
    kept = {0x200D} | inclusive(0xFE00, 0xFE0F) | inclusive(0xE0100, 0xE01EF)
    unsafe = (
        inclusive(0x00, 0x08)
        | inclusive(0x0A, 0x1F)
        | inclusive(0x7F, 0x9F)
        | {0x2028, 0x2029}
        | (ignorable - kept)
    )

    ranges = []
    for c in sorted(unsafe):
        if ranges and ranges[-1][1] == c - 1:
            ranges[-1][1] = c
        else:
            ranges.append([c, c])
    rows = "".join(f"    ({char(a)}, {char(b)}),\n" for a, b in ranges)

    Path("src/escape/table.rs").write_text(f"""\
    // Generated by `just escape-table` from Unicode {VERSION}
    // DerivedCoreProperties.txt. Do not edit.
    //
    // The characters sego never prints as themselves, as sorted, merged,
    // inclusive ranges: C0 controls except tab, DEL, C1 controls, U+2028,
    // U+2029, and every Default_Ignorable_Code_Point except U+200D,
    // U+FE00..U+FE0F and U+E0100..U+E01EF.
    pub const UNSAFE: &[(char, char)] = &[
    {rows}];
    """)

# Rebuild every capture's request from sego's own plans, send it, and rewrite the file.
capture:
    cargo test --bin sego capture -- --ignored --test-threads=1

# Live tests, re-captured responses, a drift check, and the escape table check.
live:
    cargo test --test integration live -- --ignored
    just capture
    just drift
    just escape-table
    git diff --exit-code -- src/escape/table.rs

# Fail if a re-capture changed beyond times, stars, temp names, error order.
drift:
    #!/usr/bin/env bash
    set -euo pipefail
    strip='walk(if type == "object" then del(.elapsedMilliseconds, .stars)
        | if (.errors | type) == "array"
          then .errors |= sort_by((.path | tostring), .message) else . end
      elif type == "string" then gsub("git-blame-ignore-revs[0-9]+"; "git-blame-ignore-revs")
      else . end)'
    status=0
    for f in $(git diff --name-only -- 'tests/*/*.json'); do
        a=$(git show "HEAD:$f" | jq -S "$strip")
        b=$(jq -S "$strip" "$f")
        if [[ "$a" == "$b" ]]; then
            git checkout -- "$f"
        else
            echo "drift: $f" >&2; status=1
        fi
    done
    exit "$status"

# Fetch the schema the documents are checked against into target/schema.json.
schema:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p target
    query=$(cat <<'GRAPHQL'
    query { __schema { types {
      name kind enumValues { name } possibleTypes { name }
      fields { name type { kind name
        ofType { kind name ofType { kind name ofType { kind name } } } } } } } }
    GRAPHQL
    )
    jq -n --arg q "$query" '{query: $q}' \
      | curl -sSf -A "sego-dev/0" -H 'Content-Type: application/json' \
          --data-binary @- "${SEGO_ENDPOINT:-https://sourcegraph.com}/.api/graphql" \
      > target/schema.json
    jq -e '.data.__schema.types | length' target/schema.json
